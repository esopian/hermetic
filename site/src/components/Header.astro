---
import { explainer, repo } from "../data/links";
import { dmgUrl } from "../data/release";
import Button from "./Button.astro";
---
<header class="top">
  <div class="wrap">
    <a class="brand" href="/"><span class="sq"></span>Hermetic</a>
    <nav class="main">
      <a href="/#how">How it works</a>
      <a href={explainer.home}>Explainer</a>
      <a href="/cost/">Cost</a>
      <a href="/mobile/">Mobile</a>
      <a href="/docs/">Docs</a>
      <a href={repo.home}>GitHub ↗</a>
    </nav>
    <div class="top-r">
      {/* Downloads the DMG directly, as the hero's button does. It used to jump to /#download,
          which scrolled the landing's buttons under this sticky header and moved its pinned drawing. */}
      <Button variant="p" small href={dmgUrl}>↓ Download</Button>
    </div>
  </div>
</header>
