---
/*
 * A replica of one iPhone app screen, drawn in HTML like the landing's AppTour panels. `home` is
 * the one home screen (hero row of pinned bots, then one quiet section per instance), `chat` is a
 * conversation stopped on an approval, `lock` is the lock screen with two pushes from the boxes.
 * Layout follows mobile/README.md "Screens" and docs/design.md §9.4; every agent name, preview and
 * command is illustrative.
 *
 * The frame is square like the rest of the site (site/AGENTS.md "Design system"). Inside it the
 * replica keeps the phone app's own round avatars, bubbles and buttons, because that is how the
 * app looks on an iPhone; the round shapes never leave the screen area.
 */
interface Props {
  screen: "home" | "chat" | "lock";
  label: string;
  /** Extra class on the frame, for a page to place or tilt it. */
  class?: string;
}

const { screen, label, class: cls } = Astro.props;
---
<figure class:list={["ph", cls]} role="img" aria-label={label}>
  <div class="ph-scr" data-screen={screen}>
    <div class="ph-sb" aria-hidden="true"><b>9:41</b><span class="ph-island"></span><span class="ph-ind"><i></i><i></i><i></i><em></em></span></div>

    {screen === "home" && (
      <div class="ph-body">
        {/* mobile/README.md "Screens": gear left, search and + right, no tab bar */}
        <div class="ph-bar"><span class="ph-btn">⚙</span><span class="ph-sp"></span><span class="ph-btn">⌕</span><span class="ph-btn">+</span></div>
        {/* the hero: bots pinned on this phone, a star marks a pin */}
        <div class="ph-hero">
          <div class="ph-hb"><span class="ph-av xl" data-c="a"><i class="ph-star">★</i></span><span>Atlas</span></div>
          <div class="ph-hb"><span class="ph-av xl" data-c="b"><i class="ph-dot"></i><i class="ph-star">★</i></span><span>Kestrel</span></div>
        </div>
        <div class="ph-sec"><i data-s="ok"></i>corvid</div>
        <div class="ph-row"><span class="ph-av" data-c="c"></span><div><b>corvid</b><span>Approve the volume resize?</span></div><em class="ph-need">!</em></div>
        <div class="ph-row"><span class="ph-av" data-c="d"></span><div><b>Magpie</b><span>Draft is in /data/notes…</span></div><em class="ph-unread"></em></div>
        <div class="ph-sec"><i data-s="ok"></i>lumen</div>
        <div class="ph-row"><span class="ph-av" data-c="e"></span><div><b>lumen</b><span>All 212 tests pass on the…</span></div><time>14:02</time></div>
        <div class="ph-row"><span class="ph-av" data-c="f"></span><div><b>Rook</b><span>Triage room is quiet.</span></div><time>Mon</time></div>
        {/* a box that does not answer says so and keeps its bots, dimmed */}
        <div class="ph-sec ph-dim"><i data-s="off"></i>wren · not answering</div>
        <div class="ph-row ph-dim"><span class="ph-av" data-c="g"></span><div><b>wren</b><span>Scrape finished at 03:00.</span></div><time>Sun</time></div>
      </div>
    )}

    {screen === "chat" && (
      <div class="ph-body">
        {/* mobile/README.md "Screens": back, avatar and name, one overflow menu */}
        <div class="ph-cbar"><span class="ph-btn">‹</span><span class="ph-av sm" data-c="c"></span><b>corvid</b><span class="ph-sp"></span><span class="ph-btn">⋯</span></div>
        <div class="ph-thread">
          <div class="ph-me">How did the overnight scrape go?</div>
          <p class="ph-msg">All 14 sources finished. 3,212 new rows, two retries on the supplier portal.</p>
          <p class="ph-msg">The data volume is at 91%. A live resize to 200 GiB keeps the agent running and its session open.</p>
          <div class="ph-me">Go ahead, but ask first.</div>
          <div class="ph-who"><span class="ph-av sm" data-c="c"></span><b>corvid</b><em>waiting</em></div>
          {/* design.md §9.4: an approval means on the phone what it means in §9.2; buttons are the gateway's choices */}
          <div class="ph-card">
            <div class="ph-ch"><i></i>Approval required</div>
            <b>terminal</b>
            <span>grow filesystem</span>
            <code>resize2fs /dev/nvme1n1</code>
            <div class="ph-acts"><span class="on">Approve once</span><span>This session</span><span>Always allow</span><span class="no">Deny</span></div>
          </div>
        </div>
        <div class="ph-comp"><span>Queue a message, or steer…</span><i></i></div>
      </div>
    )}

    {screen === "lock" && (
      <div class="ph-body ph-lock">
        <div class="ph-clock"><span>Thursday 15 October</span><b>9:41</b></div>
        {/* design.md §9.4 "Push": bodies name the bot and nothing of the conversation unless previews are on */}
        <div class="ph-note"><span class="ph-app"></span><div><b>Hermetic<time>now</time></b><strong>corvid</strong><span>corvid is waiting on you</span></div></div>
        <div class="ph-note"><span class="ph-app"></span><div><b>Hermetic<time>4m ago</time></b><strong>Atlas</strong><span>Atlas replied</span></div></div>
        <div class="ph-note"><span class="ph-app"></span><div><b>Hermetic<time>1h ago</time></b><strong>Rook</strong><span>New message from Rook</span></div></div>
      </div>
    )}
    <div class="ph-home" aria-hidden="true"></div>
  </div>
</figure>

<style>
  .ph {
    --w: 300px;
    width: var(--w);
    flex: none;
    margin: 0;
    padding: 10px;
    border: 2px solid var(--fg);
    background: var(--bg2);
    position: relative;
  }
  /* registration ticks on the frame, the blueprint's corner marks */
  .ph::before,
  .ph::after {
    content: "";
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--acc);
  }
  .ph::before {
    top: -9px;
    left: -9px;
    border-width: 2px 0 0 2px;
  }
  .ph::after {
    bottom: -9px;
    right: -9px;
    border-width: 0 2px 2px 0;
  }
  .ph-scr {
    position: relative;
    aspect-ratio: 393 / 852;
    background: var(--bg);
    border: 1px solid var(--line2);
    overflow: hidden;
    font-family: var(--sans);
    color: var(--fg);
    font-size: 12px;
    line-height: 1.35;
    display: flex;
    flex-direction: column;
  }
  .ph-sb {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px 6px 24px;
    font-size: 12px;
  }
  .ph-island {
    width: 74px;
    height: 20px;
    background: #000;
    border-radius: 12px;
  }
  .ph-ind {
    display: flex;
    gap: 2px;
    align-items: flex-end;
  }
  .ph-ind i {
    width: 3px;
    background: var(--fg);
    height: 5px;
  }
  .ph-ind i:nth-child(2) {
    height: 7px;
  }
  .ph-ind i:nth-child(3) {
    height: 9px;
  }
  .ph-ind em {
    width: 18px;
    height: 9px;
    margin-left: 4px;
    border: 1px solid var(--fg2);
    border-radius: 3px;
    background: linear-gradient(90deg, var(--fg) 70%, transparent 70%);
    background-clip: content-box;
    padding: 1px;
  }
  .ph-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .ph-home {
    position: absolute;
    bottom: 6px;
    left: 50%;
    width: 36%;
    height: 4px;
    margin-left: -18%;
    background: var(--fg3);
    border-radius: 2px;
  }

  /* round icon buttons (mobile/src/ui/IconButton.tsx) */
  .ph-bar,
  .ph-cbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
  }
  .ph-cbar {
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
  }
  .ph-cbar b {
    font-weight: 800;
    font-size: 14px;
  }
  .ph-sp {
    flex: 1;
  }
  .ph-btn {
    width: 30px;
    height: 30px;
    border: 1px solid var(--line2);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 15px;
    color: var(--fg);
    line-height: 1;
  }

  /* avatars: the app's soft blobs */
  .ph-av {
    position: relative;
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 47% 53% 44% 56% / 52% 46% 54% 48%;
    background: linear-gradient(140deg, #78d24a, #3fb36e);
  }
  .ph-av.sm {
    width: 22px;
    height: 22px;
  }
  .ph-av.xl {
    width: 66px;
    height: 66px;
  }
  .ph-av[data-c="b"] {
    background: linear-gradient(160deg, #4fd3a0, #8fdc63);
  }
  .ph-av[data-c="c"] {
    background: linear-gradient(140deg, #c9c83a, #d39a33);
  }
  .ph-av[data-c="d"] {
    background: linear-gradient(150deg, #43c9b9, #a6df73);
  }
  .ph-av[data-c="e"] {
    background: linear-gradient(140deg, #5be37d, #2fcfb6);
  }
  .ph-av[data-c="f"] {
    background: linear-gradient(160deg, #95d662, #3aae63);
  }
  .ph-av[data-c="g"] {
    background: linear-gradient(150deg, #d9b23a, #d2502f);
  }
  .ph-star {
    position: absolute;
    right: -2px;
    bottom: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--warn);
    border: 2px solid var(--bg);
    color: var(--acc-fg);
    font: 900 9px / 14px var(--sans);
    text-align: center;
    font-style: normal;
  }
  .ph-dot {
    position: absolute;
    right: 2px;
    top: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--acc);
    border: 2px solid var(--bg);
  }

  .ph-hero {
    display: flex;
    justify-content: center;
    gap: 26px;
    padding: 14px 0 16px;
  }
  .ph-hb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--fg2);
    font-size: 12.5px;
  }
  .ph-sec {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 10px 14px 4px;
    font: 700 9px var(--sans);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg3);
  }
  .ph-sec i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
  }
  .ph-sec i[data-s="off"] {
    background: var(--fg3);
  }
  .ph-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
  }
  .ph-row > div {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .ph-row b {
    font-weight: 800;
    font-size: 13px;
  }
  .ph-row span {
    color: var(--fg2);
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ph-row time {
    font-size: 10px;
    color: var(--fg3);
    align-self: flex-start;
    margin-top: 2px;
  }
  .ph-unread {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--acc);
  }
  .ph-need {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--warn);
    color: var(--acc-fg);
    font: 900 11px / 16px var(--sans);
    text-align: center;
    font-style: normal;
  }
  .ph-dim {
    opacity: 0.5;
  }

  /* conversation */
  .ph-thread {
    flex: 1;
    min-height: 0;
    padding: 10px 12px 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
    justify-content: flex-end;
  }
  .ph-msg {
    padding-left: 30px;
    font-size: 12px;
    color: var(--fg);
  }
  .ph-me {
    align-self: flex-end;
    max-width: 80%;
    background: var(--bg3);
    padding: 7px 12px;
    border-radius: 14px;
    font-size: 12px;
  }
  .ph-who {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ph-who b {
    font-weight: 800;
  }
  .ph-who em {
    font-style: normal;
    color: var(--acc);
    font-size: 11px;
  }
  .ph-card {
    margin-left: 30px;
    background: var(--bg2);
    border-radius: 12px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .ph-ch {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 11.5px;
  }
  .ph-ch i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--warn);
  }
  .ph-card > b {
    font-weight: 800;
    font-size: 12.5px;
  }
  .ph-card > span {
    color: var(--fg2);
    font-size: 11px;
  }
  .ph-card code {
    font: 500 10px var(--mono);
    background: var(--bg3);
    padding: 6px 8px;
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ph-acts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5px;
    margin-top: 3px;
  }
  .ph-acts span {
    border: 1px solid var(--line2);
    border-radius: 14px;
    text-align: center;
    padding: 5px 0;
    font-weight: 700;
    font-size: 10.5px;
  }
  .ph-acts .on {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }
  .ph-acts .no {
    border-color: var(--bad);
    color: var(--bad);
  }
  .ph-comp {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 10px 10px 18px;
  }
  .ph-comp span {
    flex: 1;
    border: 1px solid var(--line2);
    border-radius: 16px;
    padding: 7px 12px;
    color: var(--fg3);
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
  }
  .ph-comp i {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--line2);
    background: radial-gradient(var(--bad) 0 30%, transparent 31%);
  }

  /* lock screen */
  .ph-lock {
    background:
      linear-gradient(rgb(255 90 31 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 90 31 / 0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    padding: 0 10px;
    gap: 7px;
  }
  .ph-clock {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 18px 0 26px;
  }
  .ph-clock span {
    font-size: 12px;
    color: var(--fg2);
    font-weight: 600;
  }
  .ph-clock b {
    font-weight: 800;
    font-size: 64px;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .ph-note {
    display: flex;
    gap: 9px;
    background: rgb(40 39 35 / 0.92);
    border-radius: 16px;
    padding: 10px;
  }
  /* the fleet mark (mobile/BRANDING.md): orange cells, a cream spine, the H cell at the centre */
  .ph-app {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background:
      linear-gradient(var(--acc), var(--acc)) 4px 4px / 5px 5px no-repeat,
      linear-gradient(var(--fg), var(--fg)) 10.5px 4px / 5px 5px no-repeat,
      linear-gradient(var(--acc), var(--acc)) 17px 4px / 5px 5px no-repeat,
      linear-gradient(var(--acc), var(--acc)) 4px 10.5px / 5px 5px no-repeat,
      linear-gradient(var(--acc), var(--acc)) 10.5px 10.5px / 5px 5px no-repeat,
      linear-gradient(var(--acc), var(--acc)) 17px 10.5px / 5px 5px no-repeat,
      linear-gradient(var(--acc), var(--acc)) 4px 17px / 5px 5px no-repeat,
      linear-gradient(var(--fg), var(--fg)) 10.5px 17px / 5px 5px no-repeat,
      linear-gradient(var(--acc), var(--acc)) 17px 17px / 5px 5px no-repeat,
      var(--bg);
  }
  .ph-note > div {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    font-size: 11.5px;
  }
  .ph-note b {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
    font-size: 10px;
    color: var(--fg2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ph-note time {
    text-transform: none;
    letter-spacing: 0;
    color: var(--fg3);
  }
  .ph-note strong {
    font-weight: 800;
    margin-top: 2px;
  }
  .ph-note span {
    color: var(--fg);
  }

  @media (max-width: 640px) {
    .ph {
      --w: 260px;
    }
  }
</style>
