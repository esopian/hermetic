  }
  .b-who {
    font: 700 12px var(--sans);
    margin-bottom: 4px;
  }

  /* ── narrow widths ──────────────────────────────────────────── */
  @media (max-width: 1080px) {
    .b-stop .b-stop-in {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .b-flip .b-say {
      order: 0;
    }
  }
  @media (max-width: 640px) {
    .b-stop .b-stop-in {
      padding-top: 40px;
      padding-bottom: 44px;
    }
    .b-rep {
      box-shadow: 6px 6px 0 var(--line2);
    }
    .b-mboard {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .b-trig {
      grid-template-columns: 110px minmax(0, 1fr);
    }
    .b-chat {
      grid-template-columns: minmax(0, 1fr);
    }
    .b-rail-l {
      display: none;
    }
    .b-cr-pre {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .b-cr-p:nth-child(2) {
      border-right: 0;
    }
    .b-cr-p:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line2);
    }
    .b-cr-foot {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .b-cr-cancel {
      display: none;
    }
    .b-cr-h,
    .b-cr-form,
    .b-cr-foot {
      padding-left: 14px;
      padding-right: 14px;
    }
    .b-dkbody {
      grid-template-columns: minmax(0, 1fr);
    }
    .b-dknav {
      display: flex;
      overflow: hidden;
      border-right: 0;
      border-bottom: 3px solid var(--fg);
    }
    .b-dknav div {
      flex: none;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .b-dknav small {
      display: none;
    }
    .b-dkbtns span:first-child {
      display: none;
    }
    .b-page {
      height: 170px;
    }
    .b-vols {
      grid-template-columns: minmax(0, 1fr);
    }
    .b-lane {
      border-right: 0;
      border-bottom: 3px solid var(--fg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .b-caret,
    .b-cursor,
    .b-cookie,
    .b-claim-f span,
    .b-view.on {
      animation: none;
    }
    .b-cursor {
      left: 86%;
      top: 80%;
    }
  }
</style>

<script is:inline>
  // The tour's two live bits: the fleet view switcher cycles board, table and triage until a
  // click takes over, and the New agent panel fills itself in and presses Create.
  // Both only run while their panel is on screen. Illustrative only.
  (() => {
    const root = document.getElementById("e-tour");
    if (!root) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const onScreen = (el, cb) => {
      if (!("IntersectionObserver" in window)) return cb(true);
      new IntersectionObserver((es) => cb(es.some((e) => e.isIntersecting)), { threshold: 0.2 }).observe(el);
    };

    // Screen 1: board / table / triage
    const views = root.querySelector("[data-tour-views]");
    if (views) {
      const btns = Array.from(views.querySelectorAll("button"));
      const panes = Array.from(root.querySelectorAll(".b-view"));
      let idx = 0;
      let auto = !reduce;
      let seen = false;
      const pick = (i) => {
        idx = i;
        btns.forEach((b, j) => {
          b.classList.toggle("on", j === i);
          b.setAttribute("aria-pressed", String(j === i));
        });
        panes.forEach((p) => p.classList.toggle("on", p.dataset.pane === btns[i].dataset.v));
      };
      btns.forEach((b, i) =>
        b.addEventListener("click", () => {
          auto = false;
          pick(i);
        }),
      );
      onScreen(views.closest(".b-rep"), (v) => (seen = v));
      setInterval(() => {
        if (auto && seen && !document.hidden) pick((idx + 1) % btns.length);
      }, 3600);
    }

    // Screen 3: the New agent panel. A name is typed, Heavy is picked and the total follows,
    // Create is pressed and the drawer starts streaming; then it starts over. The markup holds
    // the finished form, which is what reduced motion keeps.
    const cr = root.querySelector("[data-tour-create]");
    if (cr && !reduce) {
      const D = JSON.parse(cr.dataset.tourCreate);
      const q = (k) => cr.querySelector(`[data-cr-${k}]`);
      const name = q("name");
      const ph = q("ph");
      const okHint = q("ok");
      const idleHint = q("idle");
      const total = q("total");
      const sub = q("sub");
      const echoEl = q("echo");
      const go = q("go");
      const form = q("form");
      const bar = q("bar");
      const kick = q("kicker");
      const title = q("title");
      const from = q("from");
      const cards = Array.from(cr.querySelectorAll("[data-cr-p]"));
      const fmt = (n) => `≈$${Math.round(n)}`;
      const subOf = (m) => `~$${(m / D.hours).toFixed(2)}/h · ready in ~8 min`;
      const press = (id) => cards.forEach((c) => c.setAttribute("aria-pressed", String(c.dataset.crP === id)));
      let timers = [];
      let seen = false;
      let busy = false;
      const at = (ms, fn) => timers.push(setTimeout(fn, ms));
      const reset = () => {
        name.textContent = "";
        ph.hidden = false;
        okHint.hidden = true;
        idleHint.hidden = false;
        press(D.from.id);
        cards.forEach((c) => c.classList.remove("hov"));
        total.textContent = fmt(D.from.month);
        sub.textContent = subOf(D.from.month);
        echoEl.textContent = `$ ${D.from.echo}`;
        from.textContent = "from Standard";
        go.classList.add("off");
        go.classList.remove("press");
        form.classList.remove("busy");
        bar.style.transition = "none";
        bar.style.width = "0";
        kick.textContent = "New agent";
        title.textContent = "Create agent";
      };
      const cycle = () => {
        timers.forEach(clearTimeout);
        timers = [];
        if (!seen) {
          busy = false;
          return;
        }
        busy = true;
        reset();
        const N = D.name;
        for (let k = 1; k <= N.length; k++)
          at(700 + k * 170, () => {
            ph.hidden = true;
            name.textContent = N.slice(0, k);
            echoEl.textContent = `$ ${D.from.echo.replace("<name>", N.slice(0, k))}`;
          });
        at(700 + N.length * 170 + 200, () => {
          okHint.hidden = false;
          idleHint.hidden = true;
          go.classList.remove("off");
        });
        const toCard = cards.find((c) => c.dataset.crP === D.to.id);
        at(2700, () => toCard?.classList.add("hov"));
        at(3100, () => {
          toCard?.classList.remove("hov");
          press(D.to.id);
          from.textContent = "from Heavy";
          echoEl.textContent = `$ ${D.to.echo}`;
          sub.textContent = subOf(D.to.month);
          const t0 = performance.now();
          const tick = (t) => {
            const k = Math.min(1, (t - t0) / 550);
            total.textContent = fmt(D.from.month + (D.to.month - D.from.month) * (1 - (1 - k) ** 3));
            if (k < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
        at(4700, () => go.classList.add("press"));
        at(5000, () => {
          go.classList.remove("press");
          kick.textContent = "Creating · streaming from engine";
          title.textContent = "Creating…";
          form.classList.add("busy");
          bar.style.transition = "width 3.2s cubic-bezier(.2,.8,.2,1)";
          bar.style.width = "55%";
        });
        at(9600, cycle);
      };
      onScreen(cr, (v) => {
        seen = v;
        if (v && !busy) cycle();
      });
    }
  })();
</script>
