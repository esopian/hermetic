  }
  .b-locked small {
    font: 500 10px var(--mono);
    color: var(--fg3);
  }
  .b-cecho {
    margin-top: 12px;
    border-top: 3px solid var(--fg);
    padding-top: 10px;
    font: 500 10.5px var(--mono);
    color: var(--fg2);
    overflow-wrap: anywhere;
