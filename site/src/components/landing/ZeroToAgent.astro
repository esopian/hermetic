<script is:inline>
  // Two players over one simulated clock. The CLI view types each command and prints its output,
  // paced line by line; the APP view is stateless markup whose data-show / data-at / data-s /
  // data-tx / data-w attributes say what it looks like at any second, paced by its own keyframes
  // (data-beats-app). Each view has its own chapter times and end time. Switching mid-run hands
  // the current second to the other player. Without script, or with reduced motion (or ?still),
  // the server-rendered finished state is what shows.
  (() => {
    const root = document.getElementById("e-zt");
    if (!root) return;
    const totals = { cli: Number(root.dataset.totalCli), app: Number(root.dataset.totalApp) };
    const appBeats = JSON.parse(root.dataset.beatsApp);
    const tm = root.querySelector(".tm");
    const body = root.querySelector("[data-body]");
    const lines = Array.from(body.querySelectorAll(".ln:not(.end)"));
    const lineT = lines.map((l) => Number(l.dataset.t));
    const end = body.querySelector("[data-end]");
    const cur = body.querySelector("[data-cur]");
    const clockEl = root.querySelector("[data-clock]");
    const stateEl = root.querySelector("[data-state]");
    const chLabels = Array.from(root.querySelectorAll("[data-chlabel]"));
    const chaps = Array.from(root.querySelectorAll("[data-chap]"));
    const segs = Array.from(root.querySelectorAll(".rseg"));
    const fills = Array.from(root.querySelectorAll("[data-fill]"));
    const names = chaps.map((c) => c.querySelector(".cn").textContent);
    const texts = lines.map((l) => {
      const tx = l.querySelector(".tx");
      return tx ? tx.textContent : null;
    });
    const pad = (n) => String(n).padStart(2, "0");
    const fmt = (s) => `${pad(Math.floor(s / 60))}:${pad(Math.floor(s % 60))}`;
    let run = 0;
    let view = "cli";
    let mode = "done"; // "ready" behind the choice, "live" while playing, "done" when finished
    const total = () => totals[view];
    let now = totals.cli;

    /* ---- the app view's timeline ---- */
    const wrap = root.querySelector("[data-app]");
    const stage = root.querySelector("[data-stage]");
    const pick = (steps, t, fallback) => {
      let v = fallback;
      for (const [at, x] of steps) if (t >= at) v = x;
      return v;
    };
    const shows = Array.from(root.querySelectorAll("[data-show]")).map((el) => {
      const [a, b] = el.dataset.show.split(",").map(Number);
      return { el, a, b };
    });
    const ats = Array.from(root.querySelectorAll("[data-at]")).map((el) => ({ el, t: Number(el.dataset.at) }));
    const sts = Array.from(root.querySelectorAll("[data-s]")).map((el) => ({ el, p: JSON.parse(el.dataset.s) }));
    const txs = Array.from(root.querySelectorAll("[data-tx]")).map((el) => ({ el, p: JSON.parse(el.dataset.tx) }));
    const ws = Array.from(root.querySelectorAll("[data-w]")).map((el) => ({ el, p: JSON.parse(el.dataset.w) }));
    const logs = Array.from(root.querySelectorAll("[data-log]"));

    function applyApp(t) {
      for (const s of shows) {
        const off = !(t >= s.a && t < s.b);
        if (s.el.hidden !== off) s.el.hidden = off;
      }
      for (const a of ats) a.el.toggleAttribute("data-on", t >= a.t);
      for (const s of sts) {
        const v = pick(s.p, t, "");
        if (s.el.dataset.v !== v) s.el.dataset.v = v;
      }
      for (const x of txs) {
        const v = pick(x.p, t, "");
        if (x.el.textContent !== v) x.el.textContent = v;
      }
      for (const x of ws) x.el.style.width = `${pick(x.p, t, 0)}%`;
      for (const l of logs) l.scrollTop = l.scrollHeight;
    }

    function fit() {
      if (wrap.hidden || tm.dataset.view !== "app") return;
      const aw = parseFloat(getComputedStyle(stage).getPropertyValue("--aw")) || 1100;
      const s = wrap.clientWidth / aw;
      stage.style.transform = `scale(${s})`;
      stage.style.height = `${wrap.clientHeight / s}px`;
    }

    /* Each view's chapter ranges, as rendered in data-span-cli / data-span-app. */
    const range = (c) => c.dataset[view === "app" ? "spanApp" : "spanCli"].split(",").map(Number);

    function setClock(s) {
      now = s;
      clockEl.textContent = fmt(s);
      let at = 0;
      chaps.forEach((c, i) => {
        const [from, to] = range(c);
        c.classList.toggle("done", s >= to);
        c.classList.toggle("on", s >= from && s < to);
        if (s >= from) at = i;
        const f = fills[i];
        if (f) f.style.width = `${Math.max(0, Math.min(1, (s - from) / (to - from))) * 100}%`;
      });
      for (const l of chLabels) l.textContent = names[at];
      if (view === "app") applyApp(s);
    }

    function setState(m) {
      mode = m;
      stateEl.textContent = m;
      stateEl.classList.toggle("live", m === "live");
    }

    /* The transcript as it stands at second s: every line due by then, fully typed (none at 0). */
    function showLines(s) {
      lines.forEach((l, i) => {
        l.classList.toggle("hid", s <= 0 || lineT[i] > s);
        if (texts[i] !== null) l.querySelector(".tx").textContent = texts[i];
      });
      end.appendChild(cur);
      body.scrollTop = s > 0 ? body.scrollHeight : 0;
    }

    function finish() {
      run++;
      setState("done");
      showLines(totals.cli);
      end.classList.remove("hid");
      setClock(total());
      body.scrollTop = body.scrollHeight;
    }

    function tween(from, to, ms, id, done) {
      if (ms <= 0 || to <= from) {
        setClock(Math.max(from, to));
        done();
        return;
      }
      const t0 = performance.now();
      const step = (stamp) => {
        if (id !== run) return;
        const p = Math.min(1, (stamp - t0) / ms);
        setClock(from + (to - from) * p);
        if (p < 1) requestAnimationFrame(step);
        else done();
      };
      requestAnimationFrame(step);
    }

    function type(el, text, perChar, id, done) {
      const tx = el.querySelector(".tx");
      tx.textContent = "";
      tx.after(cur);
      let i = 0;
      const tick = () => {
        if (id !== run) return;
        i++;
        tx.textContent = text.slice(0, i);
        if (i < text.length) setTimeout(tick, perChar + (Math.random() * perChar) / 2);
        else setTimeout(done, 260);
      };
      setTimeout(tick, 320);
    }

    // The CLI's pace between two lines. Lines printed together stream out at once; a short gap is
    // the operator or the agent at human scale; a long one (a stack, the bootstrap) is compressed,
    // and the wait before a typed command is a fixed beat.
    function cliWait(l, dt) {
      if (dt > 200) return 3000;
      if (l.classList.contains("cmd")) return 500;
      if (dt === 0) return 40;
      return Math.min(900, 180 * Math.sqrt(dt));
    }

    function playCli(s, id) {
      let i = s > 0 ? lineT.findIndex((t) => t > s) : 0;
      if (i < 0) i = lines.length;
      let at = s;
      const next = () => {
        if (id !== run) return;
        if (i >= lines.length) {
          tween(at, total(), 400, id, finish);
          return;
        }
        const idx = i++;
        const l = lines[idx];
        const t = lineT[idx];
        tween(at, t, cliWait(l, Math.max(0, t - at)), id, () => {
          at = t;
          l.classList.remove("hid");
          body.scrollTop = body.scrollHeight;
          if (texts[idx] !== null) {
            type(l, texts[idx], l.classList.contains("ans") ? 22 : 30, id, next);
          } else {
            next();
          }
        });
      };
      next();
    }

    function playApp(s, id) {
      let j = appBeats.findIndex(([t]) => t > s);
      if (j < 0) j = appBeats.length;
      let at = s;
      const next = () => {
        if (id !== run) return;
        if (j >= appBeats.length) {
          tween(at, total(), 400, id, finish);
          return;
        }
        const [t, ms] = appBeats[j];
        const prev = j > 0 ? appBeats[j - 1][0] : 0;
        j++;
        // Joining mid-segment (after a switch) plays only what is left of it.
        const left = t > prev ? ms * Math.min(1, (t - at) / (t - prev)) : ms;
        tween(at, t, left, id, () => {
          at = t;
          next();
        });
      };
      next();
    }

    function play(s) {
      const id = ++run;
      setState("live");
      const from = Math.min(s, total());
      showLines(from);
      end.classList.add("hid");
      setClock(from);
      (view === "app" ? playApp : playCli)(from, id);
    }

    /* ---- CLI | APP: one switch; a live run carries on from the same second ---- */
    const seg = root.querySelector("[data-seg]");
    const segBtns = Array.from(seg.querySelectorAll("button"));
    function setView(v) {
      view = v;
      tm.dataset.view = v;
      segBtns.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.v === v)));
      try {
        localStorage.setItem("hermetic-landing-view", v);
      } catch {}
      chaps.forEach((c, i) => {
        const [from, to] = range(c);
        if (segs[i]) segs[i].style.flex = String(to - from);
      });
      fit();
    }
    segBtns.forEach((b) =>
      b.addEventListener("click", () => {
        if (b.dataset.v === view) return;
        setView(b.dataset.v);
        if (mode === "live") play(now);
        else if (mode === "done") finish();
        else setClock(0);
      }),
    );
    seg.hidden = false;
    wrap.hidden = false;
    let saved = null;
    try {
      saved = localStorage.getItem("hermetic-landing-view");
    } catch {}
    const q = new URLSearchParams(location.search);
    setView(q.get("view") === "app" || (q.get("view") === null && saved === "app") ? "app" : "cli");
    window.addEventListener("resize", fit);

    /* ---- the choice: the run waits at 00:00 behind it; replay comes back to it ---- */
    const pickEl = root.querySelector("[data-pick]");
    const playBtns = Array.from(root.querySelectorAll("[data-play]"));
    function prime() {
      run++;
      setState("ready");
      showLines(0);
      end.classList.remove("hid");
      setClock(0);
      applyApp(0);
      pickEl.hidden = false;
    }
    playBtns.forEach((b) =>
      b.addEventListener("click", () => {
        pickEl.hidden = true;
        setView(b.dataset.play);
        play(0);
      }),
    );
    root.querySelector('[data-act="replay"]').addEventListener("click", () => {
      prime();
      playBtns[0]?.focus({ preventScroll: true });
    });
    root.querySelector('[data-act="skip"]').addEventListener("click", () => {
      pickEl.hidden = true;
      finish();
    });

    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches || q.has("still");
    if (still) {
      finish();
      // ?still&at=<seconds> freezes the view at one moment, for review screenshots.
      if (q.has("at")) {
        const s = Math.min(total(), Number(q.get("at")) || 0);
        showLines(s);
        end.classList.toggle("hid", s < total());
        setClock(s);
      }
      return;
    }
    prime();
  })();
</script>
