---
/*
 * Landing section "Zero to agent", carried over from mockup C. One session from `init --create` to
 * a chat turn, with an elapsed clock, chapters and a progress rail, played either as the typed CLI
 * transcript or as the desktop app's screens. The two heads share what AWS and the box take (the
 * op events, the bootstrap stages) but not what the operator does: the CLI types commands, the app
 * clicks through a wizard and a drawer, so each view has its own human beats, chapter times, end
 * time and playback pacing.
 *
 * The transcript's line formats are the CLI's own: op events are `pct phase message` as core's
 * fleet/init-create.ts and agents create emit them, prompts are the CLI's clack prompts
 * (packages/cli/src/commands/init.ts, confirm.ts), `agent history` rows are what hermeticd writes
 * (packages/agentd/src/stages.ts). Names, ids and timings are illustrative; the timings sit inside
 * what the docs state (foundation "typically 2-4 min" in init-create.ts, an agent "about 8 minutes
 * end to end" in docs/operations.md "Creating the first agent").
 */
import { DEFAULT_ROOT_GIB, GP3_USD_PER_GIB_MONTH, sizeById, usd } from "../../data/cost";
import StatusSquare from "../StatusSquare.astro";
import SheetHead from "./SheetHead.astro";

interface Props {
  num: string;
}

const { num } = Astro.props;
const def = sizeById("medium");

/* ---------- the transcript, and the app replica driven by the same clock ---------- */
type Kind = "cmd" | "out" | "ans" | "gap";
interface TLine {
  /** Simulated seconds since the first keystroke. */
  t: number;
  k: Kind;
  /** cmd/ans: plain text, typed. out/gap: trusted HTML built below. */
  h: string;
  /** Index into CHAPTERS when this line opens a chapter. */
  ch?: number;
}

const esc = (s: string): string => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const g = (s: string): string => `<span class="g">${esc(s)}</span>`;
const k = (s: string): string => `<span class="k">${esc(s)}</span>`;
const w = (s: string): string => `<span class="w">${esc(s)}</span>`;

const ACCT = "123456789012";
const FLEET = "k3v9q2xa";
const TAILNET = "tail7c1e.ts.net";
const ARN = `arn:aws:sts::${ACCT}:assumed-role/admin/dana`;
const HDR = `<span class="o">▸</span> ${esc(`${FLEET} · acme-prod · ${ACCT} · us-east-1 · profile acme-prod`)}`;
const VOL = "vol-0a8c3f1e27d94b650";
const INST = "i-0f2b8a7c41e3d9056";
const AMI = "ami-0c4f1e9a2b7d3e816";
const HOST = `${FLEET}-atlas.${TAILNET}`;
const IP = "100.101.7.42";
/* packages/core/src/build-versions.ts; shared/providers.ts (Bedrock's default model). */
const HERMETICD = "0.5.1";
const HERMES = "0.21.5";
const MODEL = "zai.glm-4.7-flash";
/*
 * packages/core/src/shared/presets.ts: the built-in loadout, and Standard as the default preset,
 * which is what a bare `hermetic agent create atlas` resolves to (medium, 100 GiB, 40 GiB root).
 */
const LOADOUT = [
  { name: "Light", size: "small", data: 50, root: DEFAULT_ROOT_GIB },
  { name: "Standard", size: "medium", data: 100, root: 40 },
  { name: "Heavy", size: "large", data: 200, root: 40 },
  { name: "GPU", size: "gpu-xsmall", data: 100, root: 40 },
] as const;
const PRESET = LOADOUT[1];
const presetMonth = (p: (typeof LOADOUT)[number]): number =>
  sizeById(p.size).monthlyUsd + (p.data + p.root) * GP3_USD_PER_GIB_MONTH;

/** One op event: [t, percent, phase, message, start-kind, tone]. Both views print these. */
type Ev = readonly [number, number, string, string, boolean?, "k"?];
const FOUND_T = 39;
const INIT_EVENTS: Ev[] = [
  [34, 15, "identity", `account ${ACCT} as ${ARN}`],
  [36, 19, "directory", "fleet directory ready in us-east-1 (0 fleet(s) in this account)"],
  [37, 30, "preflight", `tailscale running on ${TAILNET} as dana-mbp`],
  [
    FOUND_T,
    35,
    "foundation",
    "creating the foundation: VPC, sealed security group, agent role, bucket, 2 tables, snapshot policy",
    true,
  ],
  [61, 36, "foundation", "Vpc CREATE_COMPLETE (1/22)"],
  [79, 37, "foundation", "PublicSubnet0 CREATE_COMPLETE (3/22)"],
  [92, 38, "foundation", "AgentSecurityGroup CREATE_COMPLETE (5/22)"],
  [131, 39, "foundation", "AgentRole CREATE_COMPLETE (6/22)"],
  [158, 41, "foundation", "AgentsTable CREATE_COMPLETE (8/22)"],
  [196, 42, "foundation", "SnapshotPolicy CREATE_COMPLETE (10/22)"],
  [227, 50, "foundation", `created stack hermetic-${FLEET} (public) in 3m08s`, false, "k"],
  [229, 65, "tailscale", "tailscale OAuth client secret stored in SSM (client kQ7xT2bN4CNTRL)"],
  [231, 75, "ami", `pinned Ubuntu 24.04 arm64 image ${AMI}`],
  [233, 85, "fleet", "wrote the _fleet item"],
  [234, 87, "directory", `registered fleet ${FLEET} in the us-east-1 directory`],
  [
    241,
    92,
    "artifacts",
    `pushed artifacts/${HERMETICD}/3f9a1c07be52d481/hermeticd (sha256 7c2e90d14a6b…) and 7 stage(s); the fleet manifest names ${HERMETICD}`,
  ],
  [246, 96, "ready", `the fleet manifest names hermeticd ${HERMETICD}`],
  [
    247,
    98,
    "ready",
    "tailscale OAuth client kQ7xT2bN4CNTRL can mint tag:hermetic keys, list devices and edit the policy file",
  ],
  [249, 99, "policy", "policy: hermetic entries written (ssh, acls)"],
  [250, 100, "done", `fleet ${FLEET} created in ${ACCT} · us-east-1`, false, "k"],
];
const CREATE_EVENTS: Ev[] = [
  [261, 2, "validate", "creating atlas (medium) in us-east-1"],
  [263, 20, "secrets", "tailscale auth key minted and stored in its SSM slot"],
  [265, 40, "render", "rendered 21 files, config_hash 9c2e71d04ab35f86"],
  [268, 55, "volume", `data volume ${VOL} (${PRESET.data} GiB)`],
  [271, 80, "instance", `launching a ${def.instance} on ${AMI}`, true],
  [286, 85, "instance", `instance ${INST} recorded on the agent row`],
  [287, 90, "instance", `attaching data volume ${VOL} to ${INST}`, true],
  [301, 92, "instance", `data volume ${VOL} attached to ${INST}`],
  [302, 93, "instance", "atlas handed off to its instance; hermeticd reports from here"],
  [302, 100, "done", "atlas created", false, "k"],
];
/** The CLI's `pct phase message` line: right-aligned percent, padded phase, `…` on a start. */
const evHtml = (e: Ev): string => {
  const msg = `${e[4] ? "… " : ""}${e[3]}`;
  return `${g(`${String(e[1]).padStart(3)}%`)} <span class="ph">${esc(e[2].padEnd(12))}</span> ${
    e[5] === "k" ? k(msg) : esc(msg)
  }`;
};

/* The bootstrap stages hermeticd runs (design.md §6.3), each with its simulated window. */
const stageSecs: [string, number][] = [
  ["00-preflight", 1.6],
  ["01-tailscale", 22.4],
  ["02-data-volume", 4.1],
  ["03-config", 1.3],
  ["04-apply", 301.7],
  ["05-service", 2.2],
  ["06-verify", 13.8],
];
/* packages/ui/src/logic/bootstrap.ts stageLabel: drop the ordinal, dashes to spaces, capitalise. */
const stageLabel = (id: string): string => {
  const words = id.replace(/^\d+-/, "").replace(/-/g, " ");
  return words.charAt(0).toUpperCase() + words.slice(1);
};
const BOOT_AT = 348;
let clock = BOOT_AT;
const STAGES = stageSecs.map(([id, secs]) => {
  const start = clock;
  clock += secs;
  return { id, secs, start, end: clock, label: stageLabel(id) };
});
const READY_AT = Math.round(clock);
const TS_UP = STAGES[1]?.end ?? BOOT_AT;
const DISK_UP = STAGES[2]?.end ?? BOOT_AT;
const LISTEN_T = READY_AT + 25;
const CHAT_T = READY_AT + 30;

/* `agent history` prints newest first, in the table renderer's padded columns. */
const T0 = Date.UTC(2026, 9, 11, 14, 0, 0);
const iso = (t: number): string => new Date(T0 + t * 1000).toISOString();
const hhmmss = (t: number): string => iso(t).slice(11, 19);
const historyRows: [string, string, string, string, string][] = [
  [iso(258), "create", "-→creating", ARN, "requested"],
  [
    iso(BOOT_AT),
    "boot",
    "creating→bootstrapping",
    "hermeticd/atlas",
    `running ${STAGES.length} bootstrap stage(s) from hermeticd ${HERMETICD}`,
  ],
  ...STAGES.map((s): [string, string, string, string, string] => [
    iso(Math.round(s.end)),
    "stage",
    "-→-",
    "hermeticd/atlas",
    `${s.id} ok in ${s.secs.toFixed(1)}s`,
  ]),
  [iso(READY_AT), "ready", "bootstrapping→ready", "hermeticd/atlas", `${STAGES.length} stage(s) ok`],
];
historyRows.reverse();
const cols = ["TIMESTAMP", "ACTION", "TRANSITION", "ACTOR", "DETAIL"] as const;
const widths = cols.map((c, i) => Math.max(c.length, ...historyRows.map((r) => (r[i] ?? "").length)));
const row = (cells: readonly string[]): string =>
  cells.map((c, i) => (i === cells.length - 1 ? c : c.padEnd((widths[i] ?? 0) + 2))).join("");
const historyHtml = historyRows.map((r) => {
  const line = esc(row(r));
  return r[1] === "ready" ? `<span class="k">${line}</span>` : line;
});

const REPLY = [
  `/data is my ${PRESET.data} GiB data volume, 1% used. My home, memory, skills and`,
  "this conversation live there, so they stay put if this box is replaced.",
  `The ${PRESET.root} GiB system disk is 15% used.`,
];
const QUESTION = "what is on your data volume?";

const LINES: TLine[] = [
  { t: 0, k: "cmd", ch: 0, h: "hermetic init --create --profile acme-prod --region us-east-1" },
  {
    t: 3,
    k: "out",
    h: `<span class="o">▸</span> ${esc(`acme-prod · ${ACCT} · us-east-1 · profile acme-prod`)}`,
  },
  { t: 3, k: "out", h: g(`  caller ${ARN}`) },
  { t: 3, k: "out", h: g("  organisation o-4kq81zt2mv") },
  {
    t: 4,
    k: "out",
    h: `<span class="k">◇</span>  type the twelve-digit account id to confirm (${ACCT})`,
  },
  { t: 9, k: "ans", h: ACCT },
  { t: 10, k: "out", h: `<span class="k">◇</span>  Tailscale OAuth client secret (tskey-client-…)` },
  { t: 31, k: "ans", h: "▪".repeat(28) },
  { t: 32, k: "out", h: g(`  tailscale running · tailnet ${TAILNET} · this node dana-mbp`) },
  ...INIT_EVENTS.map(
    (e): TLine => ({ t: e[0], k: "out", h: evHtml(e), ...(e[0] === FOUND_T ? { ch: 1 } : {}) }),
  ),
  { t: 252, k: "out", h: "" },
  { t: 258, k: "cmd", ch: 2, h: "hermetic agent create atlas" },
  { t: 260, k: "out", h: HDR },
  ...CREATE_EVENTS.map((e): TLine => ({ t: e[0], k: "out", h: evHtml(e) })),
  {
    t: 303,
    k: "gap",
    ch: 3,
    h: `<span class="gap-l"></span><span>the box boots, joins your tailnet and runs ${STAGES.length} bootstrap stages</span><span class="gap-l"></span>`,
  },
  { t: READY_AT + 14, k: "cmd", h: "hermetic agent history atlas" },
  { t: READY_AT + 15, k: "out", h: HDR },
  { t: READY_AT + 15, k: "out", h: g(row(cols)) },
  ...historyHtml.map((h): TLine => ({ t: READY_AT + 15, k: "out", h })),
  { t: READY_AT + 16, k: "out", h: "" },
  {
    t: READY_AT + 20,
    k: "cmd",
    ch: 4,
    h: "hermetic agent status atlas | grep -E '^(status|tailnet name|dashboard|desktop) '",
  },
  { t: READY_AT + 21, k: "out", h: HDR },
  { t: READY_AT + 21, k: "out", h: `status             ${k("ready")}` },
  { t: READY_AT + 21, k: "out", h: `tailnet name       ${esc(HOST)}` },
  { t: READY_AT + 21, k: "out", h: `dashboard          <span class="u">https://${esc(HOST)}/</span>` },
  {
    t: READY_AT + 21,
    k: "out",
    h: `desktop            <span class="u">https://${esc(HOST)}/vnc/</span>`,
  },
  { t: LISTEN_T - 1, k: "cmd", h: "hermetic chat listen atlas" },
  { t: LISTEN_T, k: "out", h: HDR },
  { t: LISTEN_T, k: "out", h: "atlas: listening" },
  { t: CHAT_T, k: "cmd", h: `hermetic chat atlas '${QUESTION}'` },
  { t: CHAT_T + 1, k: "out", h: HDR },
  { t: CHAT_T + 3, k: "out", h: g("(thought for 2s)") },
  { t: CHAT_T + 3, k: "out", h: "" },
  { t: CHAT_T + 4, k: "out", h: g("$ bash -> running") },
  { t: CHAT_T + 5, k: "out", h: `${g("$ bash -> ")}${k("ok")}${g(" (exit 0) in 1s")}` },
  { t: CHAT_T + 5, k: "out", h: "" },
  ...REPLY.map((r, i): TLine => ({ t: CHAT_T + 7 + i, k: "out", h: w(r) })),
];
const END_T = (LINES.at(-1)?.t ?? 0) + 2;

/*
 * The app's own human beats. Up to `Open fleet` the wizard's steps sit on the transcript's prompt
 * times; after that nobody types a command: the dashboard opens empty, the New agent drawer takes
 * the name, and once atlas is ready the operator opens its Chat section and asks from the composer.
 * There is no history or status command to run, so the app reaches the chat sooner than the CLI.
 */
const A_FLEET = 252;
const A_DRAWER = 254;
const A_LISTEN = READY_AT + 2;
const A_CHAT = READY_AT + 5;
const A_SEND = A_CHAT + 6;
const APP_END = A_SEND + 11;

const CHAPTERS = [
  { name: "init", cli: 0, app: 0, note: "freeze the account" },
  { name: "foundation", cli: FOUND_T, app: FOUND_T, note: "one stack per fleet" },
  { name: "agent create", cli: 258, app: A_FLEET, note: "volume, launch, handoff" },
  { name: "bootstrap", cli: 303, app: 303, note: "the box sets itself up" },
  { name: "talk to it", cli: READY_AT + 20, app: A_CHAT, note: "over the tailnet" },
] as const;
const fmtClock = (s: number): string =>
  `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(Math.floor(s % 60)).padStart(2, "0")}`;
const chapterRange = (i: number, v: "cli" | "app"): string =>
  `${CHAPTERS[i]?.[v] ?? 0},${CHAPTERS[i + 1]?.[v] ?? (v === "cli" ? END_T : APP_END)}`;

/*
 * The app view is stateless HTML keyed to the clock. Each helper renders the finished state at
 * APP_END (what no-JS, reduced motion and ?still show) and records the timeline the script replays:
 *   sh(a, b)  visible while a <= t < b
 *   at(t)     gains data-on once the clock passes t
 *   st(steps) data-v takes the last value whose time has passed (CSS styles by it)
 *   tx(steps) the same, as text content
 */
type Steps = [number, string][];
const NEVER = 1e9;
const pick = (p: Steps, t: number): string => {
  let v = "";
  for (const [at, x] of p) if (t >= at) v = x;
  return v;
};
const sh = (a: number, b: number = NEVER) => ({
  "data-show": `${a},${b}`,
  hidden: !(APP_END >= a && APP_END < b),
});
const at = (t: number) => ({ "data-at": t, "data-on": APP_END >= t ? "" : undefined });
const st = (p: Steps) => ({ "data-s": JSON.stringify(p), "data-v": pick(p, APP_END) });
const tx = (p: Steps) => ({ "data-tx": JSON.stringify(p) });
const fin = (p: Steps): string => pick(p, APP_END);
const fmtDur = (secs: number): string =>
  secs < 60
    ? `${secs.toFixed(1)}s`
    : `${Math.floor(secs / 60)}m${String(Math.round(secs % 60)).padStart(2, "0")}s`;

/** An op's step rail: each phase pending, then current from its first event, done when the next starts. */
function rail(events: Ev[], labels: Record<string, string>) {
  const order: { phase: string; start: number }[] = [];
  for (const e of events)
    if (!order.some((o) => o.phase === e[2])) order.push({ phase: e[2], start: e[0] });
  return order.map((o, i) => {
    const next = order[i + 1]?.start;
    const done = o.phase === "done" ? o.start : next;
    const steps: Steps = [[0, "pend"]];
    if (o.phase !== "done") steps.push([o.start, "cur"]);
    if (done !== undefined) steps.push([done, "done"]);
    return {
      label: labels[o.phase] ?? o.phase,
      state: steps,
      time: done !== undefined && o.phase !== "done" ? ([[done, fmtDur(done - o.start)]] as Steps) : [],
    };
  });
}
/* packages/ui/src/lib/useOp.ts: PHASE_LABELS (init) and CREATE_LABELS. */
const INIT_RAIL = rail(INIT_EVENTS, {
  identity: "Resolve caller identity",
  preflight: "Check this machine's tailnet",
  foundation: "Create the CloudFormation stack",
  tailscale: "Store the Tailscale OAuth secret",
  ami: "Pin the Ubuntu arm64 image",
  fleet: "Write the _fleet item",
  artifacts: "Publish the hermeticd artifact",
  ready: "Check the fleet can launch an agent",
  policy: "Write hermetic's blocks into the tailnet policy",
  done: "Done",
});
const CREATE_RAIL = rail(CREATE_EVENTS, {
  validate: "Validate name and claim the row",
  secrets: "Mint the tailscale key into SSM",
  render: "Render config and manifest",
  volume: "Allocate the data volume",
  instance: "Launch the EC2 instance and attach its data volume",
  done: "Created",
});
const pctSteps = (events: Ev[]): Steps => [
  [0, "0%"],
  ...events.map((e): [number, string] => [e[0], `${e[1]}%`]),
];
/* OpProgress's log pane: `[HH:MM:SS] <glyph> <phase padded to 11> <message>`. */
const logLine = (e: Ev): string => `[${hhmmss(e[0])}] ${e[4] ? "…" : "▸"} ${e[2].padEnd(11)} ${e[3]}`;

const STATUS: Steps = [
  [0, "creating"],
  [BOOT_AT, "bootstrapping"],
  [READY_AT, "ready"],
];
const STAGE_NOW: Steps = [
  [0, ""],
  ...STAGES.map((s): [number, string] => [s.start, s.label]),
  [READY_AT, ""],
];
const LEAD: Steps = [
  [0, "Creating the instance."],
  ...STAGES.map((s): [number, string] => [s.start, `Booting: ${s.label}.`]),
  [READY_AT, "Ready and serving chats."],
];
const NAME_TYPED: Steps = [
  [A_DRAWER, ""],
  [A_DRAWER + 0.6, "a"],
  [A_DRAWER + 1.2, "at"],
  [A_DRAWER + 1.7, "atl"],
  [A_DRAWER + 2.3, "atla"],
  [A_DRAWER + 2.8, "atlas"],
];
/* The question typed into the chat composer, a few characters per step; the placeholder around it. */
const COMPOSE_PH = "Message atlas…";
const COMPOSE: Steps = [[0, COMPOSE_PH]];
for (let i = 1, n = Math.ceil(QUESTION.length / 3); i <= n; i++)
  COMPOSE.push([A_CHAT + 1 + ((A_SEND - A_CHAT - 1.5) * i) / n, QUESTION.slice(0, i * 3)]);
COMPOSE.push([A_SEND, COMPOSE_PH]);
const COMPOSE_ST: Steps = [
  [0, ""],
  [COMPOSE[1]?.[0] ?? A_SEND, "typed"],
  [A_SEND, ""],
];

/*
 * The app's playback: [simulated second, real ms] keyframes the clock tweens through, linearly
 * within each. Human beats get reading and clicking time; AWS and bootstrap waits are compressed,
 * but every op event and every stage gets a beat of its own, so a short stage is still seen running.
 */
const awaitMs = (dt: number): number => Math.round(Math.min(900, 180 * Math.sqrt(Math.max(0, dt))));
const evBeats = (events: Ev[], from: number): [number, number][] => {
  let prev = from;
  return events
    .filter((e, i) => e[0] > from && events[i + 1]?.[0] !== e[0])
    .map((e) => {
      const beat: [number, number] = [e[0], awaitMs(e[0] - prev)];
      prev = e[0];
      return beat;
    });
};
const APP_BEATS: [number, number][] = [
  [3, 1800], // the profile list; Continue
  [9, 1800], // read the account; tick the confirmation
  [10, 700], // Continue
  [14, 1500], // the Tailscale checklist; start pasting the secret
  [26, 900],
  [31, 1300], // verifying, verified
  [34, 900], // Initialize
  ...evBeats(INIT_EVENTS, 34),
  [A_FLEET, 1500], // Home bound; Open fleet
  [A_DRAWER, 1300], // the empty fleet; Create your first agent
  [A_DRAWER + 3, 1300], // the name
  [260, 1700], // brain, preset, total; Create agent
  ...evBeats(CREATE_EVENTS, 260),
  [303, 1200], // Back to fleet; atlas's drawer opens
  [BOOT_AT, awaitMs(BOOT_AT - 303)],
  ...STAGES.map((s): [number, number] => [s.end, Math.round(Math.min(3500, 450 + s.secs * 10))]),
  [A_LISTEN, 700],
  [A_CHAT, 1100], // open Chat
  [A_SEND, 2300], // type the question; Send
  [A_SEND + 4, 1500], // thinking
  [A_SEND + 5, 700], // the tool call
  [A_SEND + 7, 800],
  [A_SEND + 8, 450],
  [A_SEND + 9, 450],
  [APP_END, 600],
];
---
<section class="zt" id="e-zt" data-total-cli={END_T} data-total-app={APP_END} data-beats-app={JSON.stringify(APP_BEATS)}>
  <SheetHead num={num} kicker="Zero to agent" note="A real session, abridged" title="Zero to agent in two commands">
    {/* design.md §4.7 (init freezes the account, creates the foundation) and §6.2 (agent create): two commands. §1 (zero-secret path: AWS credentials plus a Tailscale OAuth client). Timing: docs/operations.md "about 8 minutes" per agent; init-create.ts "typically 2-4 min" for the foundation. */}
    <p>Bring an AWS profile and a Tailscale tailnet. <code>hermetic init</code> builds the fleet's foundation; <code>hermetic agent create</code> gives a Hermes agent its own sealed machine. About twelve minutes, most of it the box installing itself. Watch it in the terminal or in the app: the switch keeps your place.</p>
  </SheetHead>
      <div class="wrap hc-term">
        <div class="tm" data-view="cli">
          <div class="tm-bar">
            <span class="tm-dots"><i></i><i></i><i></i></span>
            {/* The same run, two heads: design.md §1 "If it isn't in core, it doesn't exist" (CLI and app are thin heads over one core). */}
            <span class="vseg" role="group" aria-label="Watch the run in" data-seg hidden>
              <button type="button" data-v="cli" aria-pressed="true">CLI</button>
              <button type="button" data-v="app" aria-pressed="false">APP</button>
            </span>
