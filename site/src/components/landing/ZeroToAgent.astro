  }
  .g {
    color: var(--fg3);
  }
  .tm-main {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 290px;
  }

  /* ---------- the play choice, over the whole session frame ---------- */
  .pick {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background-color: color-mix(in srgb, var(--bg) 88%, transparent);
    background-image:
      linear-gradient(var(--bg2) 1px, transparent 1px), linear-gradient(90deg, var(--bg2) 1px, transparent 1px);
    background-size: 40px 40px;
    backdrop-filter: blur(3px);
  }
  .pick[hidden] {
    display: none;
  }
  .pick-in {
    width: min(760px, 100%);
    border: 2px solid var(--fg);
    background: var(--bg);
    box-shadow: 10px 10px 0 var(--line2);
  }
  .pick-k {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--line2);
    font: 700 10px / 1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg2);
  }
  .pick-k i {
    width: 10px;
    height: 10px;
    background: var(--acc);
  }
  .pick-opts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .pick-o {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 18px;
  }
  .pick-o + .pick-o {
    border-left: 1px solid var(--line2);
  }
  .pick-b {
    justify-content: center;
    height: 64px;
    font-size: 16px;
  }
  .pick-b:focus-visible {
    outline: 3px solid var(--acc);
    outline-offset: 3px;
  }
  .pick-o span {
    font: 500 12px / 1.5 var(--mono);
    color: var(--fg2);
  }
  .pick-f {
    padding: 11px 18px;
    border-top: 1px solid var(--line2);
    font: 500 11px / 1.4 var(--mono);
    color: var(--fg3);
  }
  .tm-side {
    order: 2;
    border-left: 2px solid var(--fg);
    background: var(--bg2);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .clk-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font: 700 10px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg3);
  }
  .clk-ch {
    display: none;
    margin-left: auto;
    margin-right: 12px;
    color: var(--acc);
  }
  .ap-ss .ap-seg {
    justify-self: start;
  }
  .clk-state.live {
    color: var(--acc);
  }
  .clk {
    font: 800 76px / 0.9 var(--mono);
    letter-spacing: -0.07em;
    color: var(--fg);
    margin: 10px 0 16px;
    font-variant-numeric: tabular-nums;
  }
  .chap {
    list-style: none;
    border-top: 2px solid var(--fg);
  }
  .chap li {
    display: grid;
    grid-template-columns: 9px minmax(0, 1fr) auto;
    column-gap: 10px;
    align-items: center;
    padding: 9px 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg3);
    transition: color 0.2s;
  }
  .chap li :global(.sq) {
    width: 9px;
    height: 9px;
    background: var(--line2);
  }
  .chap .cn {
    font: 900 12px var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .chap .cd {
    grid-column: 2 / -1;
    font: 500 10.5px var(--mono);
    color: var(--fg3);
    margin-top: 2px;
  }
  .chap .ct {
    font: 500 11px var(--mono);
    font-variant-numeric: tabular-nums;
  }
  .chap li.done {
    color: var(--fg);
  }
  .chap li.done :global(.sq) {
    background: var(--ok);
  }
  .chap li.on {
    color: var(--acc);
  }
  .chap li.on :global(.sq) {
    background: var(--acc);
    animation: hpulse 1.2s infinite;
  }

  .zt .hc-term {
    padding-bottom: 24px;
  }
  .tm {
    border: 2px solid var(--fg);
    background: #0b0b0a;
    box-shadow: 12px 12px 0 var(--line2);
    color: #e6e3dc;
    font: 500 12.5px / 1.7 var(--mono);
    min-width: 0;
  }
  .tm-bar {
    display: grid;
    grid-template-columns: auto auto auto 1fr auto;
    align-items: center;
    gap: 18px;
    height: 40px;
    padding: 0 0 0 14px;
    border-bottom: 2px solid var(--fg);
    background: var(--bg2);
    font: 700 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg2);
  }
  .tm-dots {
    display: flex;
    gap: 6px;
  }
  .tm-dots i {
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--fg3);
  }
  .tm-dots i:first-child {
    background: var(--acc);
    border-color: var(--acc);
  }
  .tm-ch {
    justify-self: center;
    color: var(--acc);
  }
  .tm-ctl {
    display: flex;
    height: 100%;
  }
  .tm-ctl button {
    height: 100%;
    padding: 0 14px;
    background: transparent;
    border: 0;
    border-left: 1px solid var(--line2);
    color: var(--fg2);
    font: 700 11px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .tm-ctl button:hover {
    background: var(--fg);
    color: var(--bg);
  }
  .tm-body {
    height: 100%;
    overflow: auto;
    padding: 16px 18px 18px;
    scroll-behavior: auto;
  }
  .ln {
    white-space: pre;
    min-height: 1.7em;
  }
  .ln.hid {
    display: none;
  }
  .ln.cmd {
    color: #f1efe9;
    font-weight: 700;
    margin-top: 6px;
  }
  .ln.cmd:first-child {
    margin-top: 0;
  }
  .ln.gap {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 12px 0;
    color: var(--acc);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: normal;
  }
  .ln.gap.hid {
    display: none;
  }
  .ln.gap :global(.gap-l) {
    flex: 1;
    border-top: 1px dashed var(--acc);
  }
  .tm-body :global(.g) {
    color: #6b6963;
  }
  .tm-body :global(.o) {
    color: #ff5a1f;
  }
  .tm-body :global(.k) {
    color: #37c27f;
  }
  .tm-body :global(.w) {
    color: #f1efe9;
  }
  .tm-body :global(.ph) {
    color: #a8a59c;
  }
  .tm-body :global(.u) {
    color: #f1efe9;
    text-decoration: underline;
    text-decoration-color: #3d3b35;
    text-underline-offset: 3px;
  }
  .cur {
    display: inline-block;
    width: 8px;
    height: 15px;
    background: #ff5a1f;
    vertical-align: -2px;
    animation: blink 1s steps(1) infinite;
  }
  .rail {
    display: flex;
    gap: 2px;
    height: 12px;
    border-top: 2px solid var(--fg);
    background: #0b0b0a;
  }
  .rseg {
    position: relative;
    background: var(--bg3);
    min-width: 6px;
  }
  .rseg i {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--acc);
  }
  .tm-note {
    margin-top: 18px;
    font: 500 11px / 1.6 var(--mono);
    color: var(--fg3);
    max-width: 120ch;
  }
  .tm-note code {
    font-size: 11px;
  }

  /* ---------- CLI | APP toggle (the app's segmented control) ---------- */
  .vseg {
    display: flex;
    border: 2px solid var(--fg);
    height: 26px;
  }
  .vseg[hidden] {
    display: none;
  }
  .vseg button {
    background: transparent;
    border: 0;
    color: var(--fg);
    font: 900 10.5px var(--sans);
    letter-spacing: 0.1em;
    padding: 0 12px;
    cursor: pointer;
  }
  .vseg button[aria-pressed="true"] {
    background: var(--fg);
    color: var(--bg);
  }
  .vseg button:hover:not([aria-pressed="true"]) {
    background: var(--bg3);
  }
  .tm[data-view="cli"] .for-app,
  .tm[data-view="app"] .for-cli,
  .tm[data-view="cli"] .ap-wrap,
  .tm[data-view="app"] .tm-body {
    display: none;
  }
  .tm-views {
    position: relative;
    height: 520px;
    min-width: 0;
  }
  .ap-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg);
  }
  .ap-wrap[hidden] {
    display: none;
  }

  /* ---------- the app replica (natural size --aw, scaled to fit by the script) ---------- */
  .ap {
    --aw: 1100px;
    position: absolute;
    left: 0;
    top: 0;
    width: var(--aw);
    height: 585px;
    transform-origin: 0 0;
    background: var(--bg);
    color: var(--fg);
    font: 400 13px / 1.4 var(--sans);
    overflow: hidden;
  }
  .ap [hidden] {
    display: none !important;
  }
  .ap .mono,
  .ap-k {
    font-family: var(--mono);
  }
  .ap-k {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg3);
  }
  .okq,
  .accq,
  .offq {
    display: inline-block;
    width: 9px;
    height: 9px;
    background: var(--ok);
  }
  .accq {
    background: var(--acc);
  }
  .offq {
    background: var(--fg3);
  }
  .ap-scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
  }
  .ap-hd {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: stretch;
    height: 46px;
    border-bottom: 3px solid var(--fg);
    flex: none;
  }
  .ap-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 18px;
    border-right: 2px solid var(--fg);
    font: 900 17px var(--sans);
    letter-spacing: -0.01em;
  }
  .ap-brand i {
    width: 11px;
    height: 11px;
    background: var(--acc);
  }
  .ap-hd-r {
    grid-column: 3;
    display: flex;
    align-items: center;
    padding: 0 16px;
    font: 500 11px var(--mono);
    color: var(--fg2);
  }
  .ap-nav {
    display: flex;
  }
  .ap-nav > span {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 18px;
    font: 800 11px var(--sans);
    letter-spacing: 0.1em;
    border-right: 1px solid var(--line);
  }
  .ap-nav > span.on {
    background: var(--fg);
    color: var(--bg);
  }
  .ap-btn {
    display: inline-flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    border: 2px solid var(--fg);
    font: 900 10.5px var(--sans);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ap-btn.ap-p,
  .ap-btn[data-v="p"] {
    background: var(--fg);
    color: var(--bg);
  }
  .ap-btn.sm {
    height: 26px;
    padding: 0 9px;
    font-size: 9.5px;
  }
  .ap-btn[data-v="off"] {
    opacity: 0.35;
  }
  .ap-seg {
    display: inline-flex;
    border: 2px solid var(--fg);
    font: 800 9.5px var(--sans);
    letter-spacing: 0.08em;
  }
  .ap-seg span {
    padding: 4px 8px;
  }
  .ap-seg .on {
    background: var(--fg);
    color: var(--bg);
  }
  .ap-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 12px;
  }
  .ap-foot .ap-btn:only-child,
  .ap-foot span:empty + .ap-btn {
    margin-left: auto;
  }
  .ap-note {
    font: 500 10.5px var(--mono);
    color: var(--fg2);
  }

  /* wizard */
  .ap-wz {
    flex: 1;
    min-height: 0;
    margin: 18px 22px;
    border: 3px solid var(--fg);
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
  }
  .ap-wz-rail {
    border-right: 3px solid var(--fg);
    background: var(--bg2);
    padding: 16px;
    display: flex;
    flex-direction: column;
  }
  .ap-wz-rail .ap-k {
    margin-bottom: 8px;
  }
  .ap-wz-foot {
    margin-top: auto;
    font: 500 9.5px / 1.5 var(--mono);
    color: var(--fg3);
  }
  .ap-wz-panel {
    position: relative;
    padding: 18px 22px;
    min-width: 0;
  }
  .ap-sub {
    position: absolute;
    inset: 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-height: 0;
  }
  .ap-title {
    font: 900 22px / 1 var(--sans);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin: -4px 0 4px;
  }
  .ap-step {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    padding: 5px 0;
    border-bottom: 1px solid var(--line);
  }
  .ap-step i {
    width: 11px;
    height: 11px;
    background: var(--line2);
  }
  .ap-step b {
    font-weight: 700;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ap-wz-rail .ap-step b {
    text-transform: uppercase;
    font-size: 11.5px;
  }
  .ap-step span {
    font: 500 10px var(--mono);
    color: var(--fg3);
  }
  .ap-step[data-v="pend"] {
    opacity: 0.5;
  }
  .ap-step[data-v="cur"] i {
    background: var(--acc);
    animation: hpulse 1.2s infinite;
  }
  .ap-step[data-v="done"] i {
    background: var(--ok);
  }
  .ap-prof {
    border: 2px solid var(--fg);
  }
  .ap-prow {
    display: flex;
    justify-content: space-between;
    padding: 9px 12px;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .ap-prow:last-child {
    border-bottom: 0;
  }
  .ap-prow span {
    font: 500 11px var(--mono);
    color: var(--fg3);
  }
  .ap-prow.on {
    background: var(--sel);
    box-shadow: inset 4px 0 0 var(--acc);
  }
  .ap-input {
    height: 36px;
    border: 2px solid var(--fg);
    padding: 0 10px;
    display: flex;
    align-items: center;
    font: 500 12.5px var(--mono);
    max-width: 260px;
  }
  .ap-conn {
    border: 3px solid var(--fg);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ap-conn-h {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .ap-conn-h b {
    font: 900 14px var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ap-conn-h span {
    font: 500 10px var(--mono);
    color: var(--fg3);
  }
  .ap-acct {
    font: 700 30px / 1 var(--mono);
    letter-spacing: -0.03em;
  }
  .ap-kv {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 3px 10px;
    font-size: 11px;
  }
  .ap-kv span {
    font: 700 9px var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg3);
    padding-top: 2px;
  }
  .ap-kv b {
    font: 500 11px var(--mono);
  }
  .ap-callout {
    border-left: 3px solid var(--acc);
    padding: 5px 10px;
    font: 500 11px var(--mono);
    background: var(--bg2);
  }
  .ap-verify {
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 12px;
    align-items: center;
    border: 3px solid var(--fg);
    padding: 10px 12px;
  }
  .ap-verify i {
    width: 18px;
    height: 18px;
    border: 2px solid var(--fg);
  }
  .ap-verify[data-on] i {
    background: var(--ok);
    border-color: var(--ok);
  }
  .ap-verify b {
    display: block;
    font-weight: 800;
    font-size: 12.5px;
  }
  .ap-verify span {
    font: 500 10px var(--mono);
    color: var(--fg3);
  }
  .ap-ss {
    display: grid;
    grid-template-columns: 10px 130px minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    border: 1px solid var(--line);
    border-left: 3px solid var(--line2);
    padding: 8px 12px;
  }
  .ap-ss i {
    width: 10px;
    height: 10px;
    background: var(--line2);
  }
  .ap-ss b {
    font-weight: 800;
    font-size: 12px;
  }
  .ap-ss-d {
    font: 500 10.5px var(--mono);
    color: var(--fg2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ap-ss em {
    font: 700 9.5px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg3);
    font-style: normal;
  }
  .ap-ss.done,
  .ap-ss[data-v="done"] {
    border-left-color: var(--ok);
  }
  .ap-ss.done i,
  .ap-ss[data-v="done"] i {
    background: var(--ok);
  }
  .ap-ss.done em,
  .ap-ss[data-v="done"] em {
    color: var(--ok);
  }

  /* op progress (OpProgress.tsx) */
  .ap-prog {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
  }
  .ap-prog-top {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 12px;
  }
  .ap-prog-name {
    font: 700 22px var(--mono);
    letter-spacing: -0.02em;
  }
  .ap-prog-sub {
    font: 500 10.5px var(--mono);
    color: var(--fg2);
  }
  .ap-pct {
    font: 900 36px / 1 var(--sans);
    letter-spacing: -0.04em;
    color: var(--acc);
  }
  .ap-pct[data-v="ok"] {
    color: var(--ok);
  }
  .ap-bar {
    height: 9px;
    background: var(--line);
    border: 1px solid var(--line2);
    margin: 10px 0 8px;
  }
  .ap-bar i {
    display: block;
    height: 100%;
    background: var(--acc);
    transition: width 0.2s;
  }
  .ap-prog-cols {
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 16px;
  }
  .ap-steps {
    min-height: 0;
    overflow: hidden;
  }
  .ap-log {
    background: #0a0a09;
    color: #d8d5cc;
    border: 2px solid var(--line2);
    font: 500 10px / 1.55 var(--mono);
    padding: 8px 10px;
    overflow: hidden;
    min-height: 0;
    white-space: pre;
  }
  .ap-log > div:not([data-on]),
  .ap-msg:not([data-on]),
  .ap-tool:not([data-on]),
  .ap-msg p span:not([data-on]),
  .ap-card-ft:not([data-on]),
  .ap-hint[data-at]:not([data-on]) {
    display: none;
  }

  /* fleet */
  .ap-env {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 24px;
    padding: 0 16px;
    background: var(--acc);
    color: #0e0e0d;
    font: 700 10px var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex: none;
  }
  .ap-fbtn {
    border: 1.5px solid #0e0e0d;
    padding: 1px 6px;
  }
  .ap-env-r {
    margin-left: auto;
  }
  .ap-tb {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 18px 18px 12px;
    border-bottom: 1px solid var(--line);
    flex: none;
  }
  .ap-lens {
    display: flex;
    gap: 18px;
    margin: 4px 0 6px;
    font: 800 15px var(--sans);
    text-transform: uppercase;
    color: var(--fg3);
  }
  .ap-lens b {
    font: 900 36px / 1 var(--sans);
    letter-spacing: -0.04em;
    margin-right: 4px;
  }
  .ap-lens .on {
    color: var(--fg);
    border-bottom: 4px solid var(--fg);
  }
  .ap-legend {
    display: flex;
    gap: 14px;
    font: 700 9.5px var(--mono);
    color: var(--fg2);
    text-transform: uppercase;
  }
  .ap-legend span {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .ap-legend i {
    width: 8px;
    height: 8px;
  }
  .ap-tb-r {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .ap-board {
    flex: 1;
    padding: 2px;
    display: grid;
