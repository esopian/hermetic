<text class="nt" x="52" y="208" style="font-size:15px">Hermetic app + CLI</text>
<text class="ns" x="52" y="228">dashboard · chat · commands</text>
<text class="ns" x="52" y="246">one core, talks to AWS directly</text>
<rect class="box" x="38" y="334" width="254" height="50" style="stroke:var(--acc);stroke-width:2"/>
<rect class="tsq" x="52" y="352" width="14" height="14"/>
