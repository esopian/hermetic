<rect class="box" x="1000" y="146" width="136" height="54"/><text class="nt" x="1012" y="168">Network</text><text class="ns" x="1012" y="186">VPC</text>

<!-- Network policy around the agents -->
<rect class="sg" x="396" y="240" width="748" height="300"/>
