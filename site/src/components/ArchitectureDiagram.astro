<rect class="box hl" x="902" y="400" width="186" height="30"/><text x="912" y="420" style="font-size:13px;font-weight:800">hermeticd</text><text class="ns" x="1078" y="419" text-anchor="end">node agent</text>
<rect class="vol" x="902" y="440" width="186" height="46"/><text x="912" y="459" style="font-size:12px;font-weight:800">Data volume</text><text class="ns" x="912" y="476" style="fill:var(--ok)">memory, survives a rebuild</text>
