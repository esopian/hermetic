<path class="blk" d="M640,596 V534"/>
<path d="M630,570 L650,590 M650,570 L630,590" style="stroke:var(--bad);stroke-width:3.5"/>
<text class="ns" x="624" y="586" text-anchor="end" style="fill:var(--bad)">inbound: dropped</text>

<g class="num"><rect x="333" y="161" width="22" height="22"/><text x="344" y="176">1</text></g>
<g class="num"><rect x="445" y="268" width="22" height="22"/><text x="456" y="283">2</text></g>
<g class="num"><rect x="333" y="324" width="22" height="22"/><text x="344" y="339">3</text></g>
