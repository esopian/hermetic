<!-- Laptop to AWS, outside the tailnet -->
<path class="api" d="M292,210 H344 V172 H394" marker-end="url(#ah)"/>
<!-- hermeticd reads config from the foundation and reports back -->
<path class="pull" d="M456,326 V214" marker-end="url(#ahg)" marker-start="url(#ahg)"/>
<text class="ns" x="464" y="236" style="fill:var(--fg2)">config in · health out</text>

<!-- Internet -->
<rect x="560" y="596" width="440" height="50" style="fill:var(--bg);stroke:var(--fg2);stroke-width:2"/>
