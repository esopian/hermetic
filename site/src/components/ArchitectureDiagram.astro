<text class="k" x="672" y="346" style="fill:var(--fg2)">AGENT</text><text class="ns" x="720" y="346" style="fill:var(--fg)">corvid</text>
<rect class="tsq" x="844" y="334" width="16" height="16"/>
<line class="ts-thin" x1="852" y1="312" x2="852" y2="334"/>
<rect class="box" x="672" y="364" width="186" height="30"/><text x="682" y="384" style="font-size:13px;font-weight:800">Hermes</text><text class="ns" x="848" y="383" text-anchor="end">the agent itself</text>
<rect class="box hl" x="672" y="400" width="186" height="30"/><text x="682" y="420" style="font-size:13px;font-weight:800">hermeticd</text><text class="ns" x="848" y="419" text-anchor="end">node agent</text>
<rect class="vol" x="672" y="440" width="186" height="46"/><text x="682" y="459" style="font-size:12px;font-weight:800">Data volume</text><text class="ns" x="682" y="476" style="fill:var(--ok)">memory, survives a rebuild</text>
</g>
<g>
<rect class="ec2" x="890" y="328" width="210" height="172"/>
