{
  "name": "hermetic-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "sync": "bun scripts/sync-docs.ts && bun scripts/cli-reference.ts",
    "build": "bun run sync && astro build",
    "check": "bun run sync && astro check && biome check . && bun scripts/sync-docs.ts --check",
    "preview": "wrangler dev",
    "deploy": "bun scripts/deploy.ts",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.2",
    "github-slugger": "2.0.0",
    "starlight-links-validator": "0.27.0",
    "typescript": "7.0.2",
    "wrangler": "4.149.0"
  }
}
