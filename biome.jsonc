{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!packages/agentd/dist",
      // Hutch's generated devkit projection and Electrobun's build output. Both
      // are regenerated from the pins, neither is committed.
      "!packages/app/.hutch",
      "!packages/app/build",
      "!packages/app/artifacts",
      // Snapshots are generated by `bun test -u`; reformatting them would fight the generator.
      "!**/__snapshots__",
      "!**/*.snap",
      "!**/bun.lock",
      "!**/*.md",
      // graft rewrites its hook helpers and its settings entries on every run; formatting them
      // would fight the generator the same way snapshots do.
      "!.claude"
    ]
  },
  // Chosen to match the code as it was already written, so adopting the formatter is churn-free
  // where it can be: 2-space indent, double quotes, semicolons, trailing commas everywhere.
  // lineWidth 104 was measured against the tree (see CONTRIBUTING.md): it reformats 173 files,
  // where 96 reformats 210 and 120 reformats 201 — it is the width this code was already wrapped at.
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 104,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteProperties": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        // `opts["maxTurns"]` on a Commander/`Record<string, unknown>` bag is deliberate: the
        // brackets mark the value as coming from an untyped option bag rather than a typed object.
        // 355 sites, and Biome's only fix is its unsafe one.
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        // Several effects deliberately disagree with React's dependency heuristic: `epoch` counters
        // that exist to re-run an effect, and refs read once on mount. Obeying it would change when
        // they fire, which is behaviour, not style.
        "useExhaustiveDependencies": "off"
      },
      "suspicious": {
        // The only check for `any` in the repo (scripts/lint.ts rule 2 was removed 2026-09-20).
        "noExplicitAny": "error",
        // `void (code = await r.materialise())` in test callbacks and `(cache[k] ??= make())`
        // memoisation in portal.ts are deliberate idioms, not accidental assignments.
        "noAssignInExpressions": "off",
        // Skeleton and placeholder rows are positional by construction — they have no identity to
        // key on until the real data arrives.
        "noArrayIndexKey": "off",
        // CloudFormation `Fn::Sub` bodies and systemd unit templates carry literal `${...}` in plain
        // strings on purpose; that is the wire format, not a mistyped template literal.
        "noTemplateCurlyInString": "off"
      },
      "style": {
        // TypeScript strict + noUncheckedIndexedAccess makes `!` the idiomatic narrowing after a
        // checked index or `find`; ~900 uses, nearly all in tests asserting on a value they just
        // proved exists. hujson.ts uses it the same way after its own bounds checks.
        "noNonNullAssertion": "off",
        // 85 sites, all `"literal" + value` where the literal is the thing being explained
        // (render.ts's manifests, agentd's unit files). Biome offers only its *unsafe* fix here, so
        // the choice is 85 unreviewed rewrites or leaving a style preference the repo never took.
        "useTemplate": "off",
        // styles.css is ordered by surface, not by specificity; reordering rules to satisfy
        // specificity ordering is a restyle, not a lint fix.
        "noDescendingSpecificity": "off"
      },
      "a11y": {
        // FleetBoard/FleetTable are CSS-grid layouts annotated with ARIA roles (docs/ui-brief.md).
        // Swapping in <table>/<fieldset> is a redesign, not a lint fix.
        "useSemanticElements": "off",
        // Fires on `role="row"` inside `role="table"` (not `grid`), where rows must not be tab stops.
        "useFocusableInteractive": "off",
        // The drawers and wizard steps focus their first field when they open. That is the intended
        // modal behaviour, not a focus steal on page load.
        "noAutofocus": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "overrides": [
    {
      // packages/ui is the one package allowed to reach for `any` (AGENTS.md).
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
