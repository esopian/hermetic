{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev"]
    },
    {
      "name": "dev:hmr",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:hmr"],
      "port": 5273,
      "autoPort": false
    },
    {
      "name": "dev:fixture",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:fixture"]
    },
    {
      "name": "dev:wizard",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:wizard"]
    },
    {
      "name": "site",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd site && bun install --frozen-lockfile && bun run sync && bun run dev -- --port 4322 --ignore-lock"],
      "port": 4322
    }
  ]
}
