{
  "name": "hermetic",
  "version": "0.1.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bash scripts/dev-setup.sh",
    "setup:check": "bash scripts/dev-setup.sh --check",
    "agent-setup": "bash scripts/agent-setup.sh",
    "agent-setup:check": "bash scripts/agent-setup.sh --check",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:dynamodb-local": "HERMETIC_DYNAMODB_LOCAL=${HERMETIC_DYNAMODB_LOCAL:-http://127.0.0.1:8000} bun test tests/integration/dynamodb-local.test.ts",
    "typecheck": "bun scripts/typecheck.ts",
    "format": "biome format --write .",
    "lint:biome": "biome check .",
    "lint": "bun scripts/lint.ts",
    "lint:cfn": "bun scripts/lint-cfn.ts",
    "lint:sh": "bun scripts/lint-sh.ts",
    "boundaries": "bun test tests/boundaries.test.ts",
    "audit:dependencies": "bun scripts/audit-dependencies.ts",
    "check": "bun run typecheck && bun run test && bun run lint:biome && bun run lint && bun run lint:cfn && bun run lint:sh",
    "ci": "bun run check && bun run build && bun run audit:dependencies",
    "build": "bun scripts/build.ts full",
    "app:stage": "bun scripts/app-stage.ts",
    "app:prepare": "cd packages/app && PATH=$PATH:$HOME/.hutch/bin hutch electrobun prepare",
    "app:build": "bun run app:build:stable",
    "app:build:canary": "cd packages/app && PATH=$PATH:$HOME/.hutch/bin hutch run build:canary",
    "app:build:stable": "cd packages/app && PATH=$PATH:$HOME/.hutch/bin hutch run build:stable",
    "build:host": "bun scripts/build.ts host",
    "build:all": "bun scripts/build.ts all",
    "release": "bun scripts/release.ts",
    "prepare": "git config core.hooksPath .githooks",
    "dev": "bun scripts/dev-app.ts dev",
    "dev:fixture": "bun scripts/dev-app.ts dev:fixture",
    "dev:wizard": "bun scripts/dev-app.ts dev:wizard",
    "dev:hmr": "bun scripts/dev-hmr.ts real",
    "dev:fixture:hmr": "bun scripts/dev-hmr.ts fixture",
    "dev:wizard:hmr": "bun scripts/dev-hmr.ts wizard",
    "cli": "bun packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1124.0",
    "@aws-sdk/lib-dynamodb": "^3.1124.0",
    "@biomejs/biome": "2.5.12",
    "@hermetic/cli": "workspace:*",
    "@hermetic/core": "workspace:*",
    "@hermetic/app": "workspace:*",
    "@types/bun": "^1.4.0",
    "bun-types": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
