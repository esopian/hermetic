      {
        "content": 
"# Rendered by hermetic. Final file, no templating.
# The hermes account's own install locations, for every login shell it gets:
# Hermes's terminal tool (bash -l) and an operator's \`sudo -iu hermes\`.
if [ "$(id -un 2>/dev/null)" = "hermes" ]; then
  export HERMES_DISABLE_LAZY_INSTALLS=1
  export HERMES_LAZY_INSTALL_TARGET=/data/hermes/.hermes/lazy-packages
  export NPM_CONFIG_PREFIX=/data/hermes/.local
  if [ -x /data/hermes/.venv/bin/python ]; then
    export VIRTUAL_ENV=/data/hermes/.venv
    case ":$PATH:" in
      *":/data/hermes/.venv/bin:"*) ;;
      *) PATH="/data/hermes/.venv/bin:$PATH" ;;
    esac
    export PATH
  fi
fi
"
