EnvironmentFile=-/etc/hermes/revision.env
SupplementaryGroups=docker
Environment=DEBIAN_FRONTEND=noninteractive
Environment=HERMES_DISABLE_LAZY_INSTALLS=1
Environment=HERMES_LAZY_INSTALL_TARGET=/data/hermes/.hermes/lazy-packages
Environment=NPM_CONFIG_PREFIX=/data/hermes/.local
LimitNOFILE=4096
Environment=DISPLAY=:99
Environment=AGENT_BROWSER_EXECUTABLE_PATH=/opt/hermetic/chrome/153.0.8010.12/chrome-linux-arm64/chrome
Environment=AWS_REGION=us-west-2
Environment=AWS_DEFAULT_REGION=us-west-2

[Install]
WantedBy=multi-user.target
