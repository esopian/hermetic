"# Rendered by hermetic. Final file, no templating.
[Unit]
Description=Hermes agent (pinned 0.15.0)
After=network-online.target
Wants=network-online.target
After=hermetic-secrets.service
Requires=hermetic-secrets.service

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/data/hermes/.hermes
ExecStart=/usr/local/bin/hermes dashboard --no-open --skip-build --host 127.0.0.1 --port 9119
Restart=always
RestartSec=5
Environment=HERMES_HOME=/data/hermes/.hermes
Environment=HERMES_WEB_DIST=/usr/local/lib/hermes-agent/hermes_cli/web_dist
Environment=HERMES_TUI_DIR=/usr/local/lib/hermes-agent/ui-tui
EnvironmentFile=/run/hermetic/secrets.env
EnvironmentFile=-/etc/hermes/revision.env
SupplementaryGroups=docker
Environment=DEBIAN_FRONTEND=noninteractive
Environment=HERMES_DISABLE_LAZY_INSTALLS=1
LimitNOFILE=4096
Environment=DISPLAY=:99
Environment=AGENT_BROWSER_EXECUTABLE_PATH=/opt/hermetic/chrome/153.0.8010.12/chrome-linux-arm64/chrome

[Install]
WantedBy=multi-user.target
