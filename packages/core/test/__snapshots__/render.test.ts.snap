CDP_PORT=9222
RFB_PORT=5900
WS_PORT=6080
PROFILE_DIR=/data/hermes/browser/default
CHROME_BIN=/opt/hermetic/chrome/153.0.8010.12/chrome-linux-arm64/chrome
# templates=d346fea1e36032ae
"
