[Unit]
Description=Xvfb in-memory X display for browser %i

[Service]
Type=simple
User=hermes
Group=hermes
EnvironmentFile=/etc/hermetic/browser/%i.env
ExecStart=/usr/bin/Xvfb \${DISPLAY} -screen 0 1920x1080x24 -nolisten tcp
Restart=always

[Install]
WantedBy=multi-user.target
