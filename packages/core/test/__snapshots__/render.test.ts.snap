include <tunables/global>

# Chrome's sandbox needs an unprivileged user namespace, which noble's
# kernel.apparmor_restrict_unprivileged_userns=1 denies to unconfined
# binaries. This profile grants exactly that to hermetic's pinned build and
# nothing else, so the sandbox stays on and --no-sandbox stays out.
profile hermetic-chrome /opt/hermetic/chrome/**/chrome-linux-arm64/chrome flags=(unconfined) {
  userns,
  include if exists <local/hermetic-chrome>
}
"
,
        "mode": "0644",
        "path": "/etc/apparmor.d/hermetic-chrome",
      },
      {
        "content": 
"# Rendered by hermetic. Final file, no templating.
# The addresses of browser \`default\`, read by xvfb@, hermetic-wm@,
# x11vnc@, novnc@ and hermetic-browser@ for this instance name.
DISPLAY=:99
CDP_PORT=9222
RFB_PORT=5900
WS_PORT=6080
PROFILE_DIR=/data/hermes/browser/default
CHROME_BIN=/opt/hermetic/chrome/153.0.8010.12/chrome-linux-arm64/chrome
# templates=d346fea1e36032ae
"
,
        "mode": "0644",
        "path": "/etc/hermetic/browser/default.env",
        "restart_units": [
          "xvfb@default.service",
          "hermetic-wm@default.service",
          "x11vnc@default.service",
          "novnc@default.service",
          "hermetic-browser@default.service",
        ],
      },
      {
        "content": 
"<!doctype html>
<!-- Rendered by hermetic. Final file, no templating. -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/vnc/vnc.html?path=vnc/websockify&autoconnect=true&resize=scale&reconnect=true" />
    <title>Agent desktop</title>
  </head>
  <body>
    <a href="/vnc/vnc.html?path=vnc/websockify&autoconnect=true&resize=scale&reconnect=true">Open the agent's desktop</a>
  </body>
</html>
"
,
        "mode": "0644",
        "path": "/usr/share/novnc/index.html",
      },
      {
        "content": 
"# Rendered by hermetic. Final file, no templating.
[Unit]
Description=Materialise atlas's secrets into a tmpfs environment file
After=network-online.target
Wants=network-online.target
After=tailscaled.service
Wants=tailscaled.service
Before=hermes-dashboard.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/install -d -m 0711 /run/hermetic
ExecStart=/usr/local/bin/hermeticd secrets materialise --out /run/hermetic/secrets.env --mode 0600
# AI_GATEWAY_API_KEY is read from SSM at this fleet's SSM prefix + atlas/provider-key by hermeticd.
# The bws access token is read from SSM at this fleet's SSM prefix + atlas/bws-token by hermeticd.

[Install]
WantedBy=multi-user.target
"
,
        "mode": "0644",
        "path": "/etc/systemd/system/hermetic-secrets.service",
      },
    ],
    "hermes_ref": "v2026.8.31",
    "hermes_version": "0.15.0",
    "instance_type": "r8g.2xlarge",
    "name": "atlas",
    "packages": [
      "apparmor",
      "at-spi2-common",
      "bws",
      "ca-certificates",
      "containerd.io",
      "curl",
      "docker-ce",
      "docker-ce-cli",
      "ffmpeg",
      "fonts-freefont-ttf",
      "fonts-ipafont-gothic",
      "fonts-liberation",
      "fonts-noto-color-emoji",
      "fonts-tlwg-loma-otf",
      "fonts-unifont",
      "fonts-wqy-zenhei",
      "git",
      "gnupg",
      "jq",
      "libatk-bridge2.0-0t64",
      "libatk1.0-0t64",
      "libatomic1",
      "libatspi2.0-0t64",
      "libcups2t64",
      "libxcomposite1",
      "matchbox-window-manager",
      "nftables",
      "nginx-light",
      "novnc",
      "ripgrep",
      "sudo",
      "tailscale",
      "unzip",
      "x11-utils",
      "x11vnc",
      "xfonts-cyrillic",
      "xfonts-encodings",
      "xfonts-scalable",
      "xfonts-utils",
      "xvfb",
      "xz-utils",
    ],
    "provider": "vercel",
    "requires": [
      "gateway-unit",
      "restart-units",
      "browser-stack",
    ],
    "schema_version": 1,
    "secrets_mode": "bitwarden",
    "size": "large",
    "tailscale_serve": {
      "enabled": true,
      "routes": [
        {
          "description": "Hermes dashboard, through the loopback proxy",
          "path": "/",
          "target": "http://127.0.0.1:9120",
        },
        {
          "description": "noVNC (default)",
          "path": "/vnc",
          "target": "http://127.0.0.1:6080",
        },
      ],
    },
    "units": [
      "hermetic-secrets.service",
      "xvfb@default.service",
      "hermetic-wm@default.service",
      "x11vnc@default.service",
      "novnc@default.service",
      "hermetic-browser@default.service",
      "hermetic-nftables.service",
      "hermeticd.service",
      "hermes-dashboard.service",
      "hermes-gateway.service",
      "nginx.service",
    ],
  },
}
`;
