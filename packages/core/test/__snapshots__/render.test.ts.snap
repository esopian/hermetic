# NOUS_API_KEY is read from SSM at this fleet's SSM prefix + atlas/provider-key by hermeticd.
# The bws access token is read from SSM at this fleet's SSM prefix + atlas/bws-token by hermeticd.

[Install]
WantedBy=multi-user.target
