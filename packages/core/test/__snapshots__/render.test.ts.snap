"# Rendered by hermetic for agent atlas. Final file, no templating.
#
# Hermes managed scope. Every key below overrides the same key in this
# agent's own /data/hermes/.hermes/config.yaml and cannot be changed on the box:
# \`hermes config set\` refuses a managed key. Change it with
# \`hermetic agent set atlas ...\` and apply.
model:
  provider: "anthropic"
# ANTHROPIC_API_KEY comes from /run/hermetic/secrets.env, which hermeticd
# writes at boot from this agent's SSM slot. The key is never rendered.
updates:
  check: false
browser:
