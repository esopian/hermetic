"# Rendered by hermetic for agent atlas. Final file, no templating.
#
# Hermes managed scope. Every key below overrides the same key in this
# agent's own /data/hermes/.hermes/config.yaml and cannot be changed on the box:
# \`hermes config set\` refuses a managed key. Change it with
# \`hermetic agent set atlas ...\` and apply.
model:
  provider: "vercel"
# AI_GATEWAY_API_KEY comes from /run/hermetic/secrets.env, which hermeticd
# writes at boot from this agent's SSM slot. The key is never rendered.
updates:
  check: false
browser:
  cdp_url: "http://127.0.0.1:9222"
  headed: true
  engine: chrome
platform_hints:
  hermetic:
    replace: "You are chatting through hermetic, the fleet operator's web portal to this box, over the gateway websocket. Markdown renders with GitHub flavor (tables, fenced code, lists). Files: there is no attachment channel and MEDIA:/path tags are NOT intercepted here (they print as literal text) — deliver a file by stating its absolute path or URL in plain text. Cron jobs scheduled from this session are LOCAL-ONLY: their output is saved (viewable via cronjob action='list') but is NOT delivered back into this session — there is no live-delivery channel here. If the user wants to be notified when a job runs, the job's \`deliver\` must target a gateway-connected messaging platform (e.g. deliver='telegram' or 'all'). Do not promise that a deliver='origin' or default-deliver cron job will message them in this session."
"
,
        "group": "hermes",
        "mode": "0640",
        "owner": "root",
        "path": "/etc/hermes/config.yaml",
        "restart_units": [
          "hermes-dashboard.service",
          "hermes-gateway.service",
        ],
      },
      {
        "content": 
"# Rendered by hermetic for agent atlas. Final file, no templating.
#
# Seeded into /data/hermes/.hermes/config.yaml on first boot, and only then.
# Everything here is yours to change — from this agent's dashboard, or with
# \`hermes config set\`. hermetic will not write it again.
#
# Keys hermetic holds instead live in /etc/hermes/config.yaml and win
# over anything set here.
model:
  default: "deepseek/deepseek-v4.1-flash"
agent:
  max_turns: 500
  reasoning_effort: "medium"
terminal:
  backend: "local"
# Whether this agent asks before running a command it thinks is risky.
# hermetic seeds \`off\` because nobody is at this keyboard: an approval
# prompt here is a hung turn rather than a second pair of eyes. See
# \`ApprovalsMode\` in hermetic for the rest of the argument, including the
# blocklist that holds in every mode.
#
# Yours to change, from this agent's dashboard or with \`hermes config
# set approvals.mode\`. hermetic writes it again only if the operator
# changes the answer they stated.
approvals:
  mode: "off"
database:
  journal_mode: "wal"
runtime:
  nofile_soft_limit: 4096
# Commands approved once, for every session. At the \`approvals.mode\`
# hermetic seeds nothing here is consulted at all — this list is for the
# operator who sets the mode to \`smart\` or \`manual\`, where it is the
# difference between installing a package and waiting on a prompt nobody
# is there to give.
#
# The list is no longer what the sudoers drop-in grants: that file now
# grants everything, and a list of every command is not a list. These four
# are apt-get and apt spelled both ways round — with and without \`sudo\` —
# because a model will write either, and they are what an agent reaches for
# first on a box where approvals are being asked for at all.
#
# Yours to extend: answering \`always\` to an approval adds to this list, and
# hermetic will not write it again. What the agent may do as root is the
# sudoers drop-in's business, not this list's.
command_allowlist:
  - "apt-get *"
  - "sudo apt-get *"
  - "apt *"
  - "sudo apt *"
"
,
        "mode": "0644",
        "path": "/etc/hermes/config.seed.yaml",
      },
      {
        "content": 
"{"schema":1,"deployment_kind":"image","manager":"hermetic","version":"v2026.8.31"}
"
,
        "mode": "0644",
        "path": "/etc/hermes/image-provenance.json",
      },
      {
        "content": 
"# Rendered by hermetic. Final file, no templating.
[Unit]
Description=Hermes agent (pinned 0.15.0)
After=network-online.target
Wants=network-online.target
After=hermetic-secrets.service
Requires=hermetic-secrets.service

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/data/hermes/.hermes
ExecStart=/usr/local/bin/hermes dashboard --no-open --skip-build --host 127.0.0.1 --port 9119
Restart=always
RestartSec=5
Environment=HERMES_HOME=/data/hermes/.hermes
Environment=HERMES_WEB_DIST=/usr/local/lib/hermes-agent/hermes_cli/web_dist
Environment=HERMES_TUI_DIR=/usr/local/lib/hermes-agent/ui-tui
EnvironmentFile=/run/hermetic/secrets.env
EnvironmentFile=-/etc/hermes/revision.env
SupplementaryGroups=docker
Environment=DEBIAN_FRONTEND=noninteractive
Environment=HERMES_DISABLE_LAZY_INSTALLS=1
Environment=HERMES_LAZY_INSTALL_TARGET=/data/hermes/.hermes/lazy-packages
Environment=NPM_CONFIG_PREFIX=/data/hermes/.local
LimitNOFILE=4096
Environment=DISPLAY=:99
Environment=AGENT_BROWSER_EXECUTABLE_PATH=/opt/hermetic/chrome/153.0.8010.12/chrome-linux-arm64/chrome

[Install]
WantedBy=multi-user.target
"
,
        "mode": "0644",
