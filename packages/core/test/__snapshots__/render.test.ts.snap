[Unit]
Description=x11vnc bound to loopback for browser %i
After=xvfb@%i.service
Requires=xvfb@%i.service

[Service]
Type=simple
User=hermes
Group=hermes
EnvironmentFile=/etc/hermetic/browser/%i.env
ExecStart=/usr/bin/x11vnc -display \${DISPLAY} -localhost -rfbport \${RFB_PORT} -forever -shared -nopw
Restart=always

[Install]
WantedBy=multi-user.target
"
,
        "mode": "0644",
        "path": "/etc/systemd/system/x11vnc@.service",
      },
      {
        "content": 
"# Rendered by hermetic. Final file, no templating.
#
# A systemd template: one instance per browser identity, named by the
# manifest's \`browsers\` list. \`%i\` is the identity's name.
[Unit]
Description=noVNC websocket bridge for browser %i
After=x11vnc@%i.service
Requires=x11vnc@%i.service

[Service]
Type=simple
User=hermes
Group=hermes
EnvironmentFile=/etc/hermetic/browser/%i.env
ExecStart=/usr/bin/websockify --web /usr/share/novnc 127.0.0.1:\${WS_PORT} 127.0.0.1:\${RFB_PORT}
Restart=always

[Install]
WantedBy=multi-user.target
"
