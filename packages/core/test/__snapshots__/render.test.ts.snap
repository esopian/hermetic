"# Rendered by hermetic. Final file, no templating.
[Unit]
Description=Materialise atlas's secrets into a tmpfs environment file
After=network-online.target
Wants=network-online.target
After=tailscaled.service
Wants=tailscaled.service
Before=hermes-dashboard.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/install -d -m 0700 /run/hermetic
ExecStart=/usr/local/bin/hermeticd secrets materialise --out /run/hermetic/secrets.env --mode 0600
# OPENAI_API_KEY is read from SSM at this fleet's SSM prefix + atlas/provider-key by hermeticd.
# The bws access token is read from SSM at this fleet's SSM prefix + atlas/bws-token by hermeticd.

[Install]
WantedBy=multi-user.target
"
