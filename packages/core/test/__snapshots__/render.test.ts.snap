RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/hermetic/nftables.hermetic.nft
ExecReload=/usr/sbin/nft -f /etc/hermetic/nftables.hermetic.nft

[Install]
WantedBy=multi-user.target
