After=x11vnc@%i.service
Requires=x11vnc@%i.service

[Service]
Type=simple
User=hermes
Group=hermes
EnvironmentFile=/etc/hermetic/browser/%i.env
ExecStart=/usr/bin/websockify --web /usr/share/novnc 127.0.0.1:\${WS_PORT} 127.0.0.1:\${RFB_PORT}
Restart=always

[Install]
WantedBy=multi-user.target
"
