exports[`--json output is a golden contract plan policy 1`] = `
{
  "kind": "policy",
  "options": {
    "etag": ""fixture-policy-1"",
  },
  "steps": [
    {
      "description": "skip "tagOwners": \`tag:hermetic\` is already owned outside hermetic's block — left exactly as you wrote it, because two entries for one tag would be invalid",
      "destructive": false,
      "id": "tagOwners",
    },
    {
      "description": "add hermetic's block in "ssh"",
      "destructive": false,
      "id": "ssh",
    },
    {
      "description": "add hermetic's block in "acls"",
      "destructive": false,
      "id": "acls",
    },
    {
      "description": "POST the policy back with If-Match "fixture-policy-1" — validated first, refused if the file has moved",
      "destructive": true,
      "id": "write",
    },
  ],
  "summary": {
    "account_id": "123456789012",
    "fleet_id": "fxtr0001",
    "region": "us-west-2",
    "stack_id": null,
  },
  "target": "tailnet",
  "warnings": [
    "hermetic edits only the lines between its \`// hermetic:managed begin\` / \`// hermetic:managed end\` markers; every other byte of the policy — comments, key order, your own rules — is written back byte for byte",
    "\`tag:hermetic\` is already owned outside hermetic's block — left exactly as you wrote it, because two entries for one tag would be invalid",
    
"the change, as a unified diff:
      --- tailnet policy (current)
      +++ tailnet policy (after apply)
      @@ ssh (new block at end of container) @@
      +    // hermetic:managed begin
      +    { "action": "accept", "src": ["autogroup:member"], "dst": ["tag:hermetic"], "users": ["autogroup:nonroot", "root"] },
      +    // hermetic:managed end
      @@ acls (new block at end of container) @@
      +    // hermetic:managed begin
      +    { "action": "accept", "src": ["autogroup:member"], "dst": ["tag:hermetic:22", "tag:hermetic:443", "tag:hermetic:7434"] },
      +    // hermetic:managed end"
,
  ],
}
`;

exports[`--json output is a golden contract plan teardown 1`] = `
{
  "kind": "teardown",
  "options": {
    "delete_snapshots": false,
    "delete_volumes": false,
    "purge": true,
    "reset_local": true,
  },
  "steps": [
    {
      "description": "take the fleet-wide lock, then refuse if any non-destroyed agent exists",
      "destructive": false,
      "id": "agents_check",
    },
    {
      "description": "empty the versioned fleet bucket: every object version and delete marker, or DeleteStack fails on BucketNotEmpty",
      "destructive": true,
      "id": "bucket",
    },
    {
      "description": "DeleteStack hermetic-fxtr0001: the VPC and its subnets, the sealed agent security group, the tag-scoped agent role and instance profile, the versioned S3 bucket, the hermetic-fxtr0001-agents and hermetic-fxtr0001-events DynamoDB tables, and the DLM snapshot policy with its role — every one of them named for the stack, so nothing outlives it under a name another fleet could want",
      "destructive": true,
      "id": "stack",
    },
    {
      "description": "mark fxtr0001 ("main") torn_down in the account's fleet directory; the entry is kept as the record that this fleet existed, and its alias stays reserved",
      "destructive": false,
      "id": "directory",
    },
    {
      "description": "Tailnet policy left unchanged; managed rules may serve other fleets. Review them manually in the Tailscale admin console if cleanup is desired.",
      "destructive": false,
      "id": "tailscale",
    },
    {
      "description": "delete 21 SSM parameter(s) under /hermetic/fxtr0001/ and /hermes/fxtr0001/",
      "destructive": true,
      "id": "ssm",
    },
    {
      "description": "archive the local runs log and remove the frozen config row, returning this home to uninitialized",
      "destructive": true,
      "id": "local",
    },
  ],
  "summary": {
    "account_id": "123456789012",
    "fleet_id": "fxtr0001",
    "region": "us-west-2",
    "stack_id": "arn:aws:cloudformation:us-west-2:123456789012:stack/hermetic-fxtr0001/fixture",
  },
  "target": "hermetic-fxtr0001 · 123456789012 · us-west-2",
  "warnings": [
    "the fleet is locked for the duration: no creates, destroys or foundation updates from any laptop until this teardown finishes, or its lock expires ten minutes after the laptop running it stops",
    "11 agent(s) still exist (atlas, corvid, ember, fathom, granite, heron, ibis, juniper, kestrel, lumen, marrow); teardown will refuse",
    "pre-v3 SSM parameters under /hermetic/ and /hermes/ are not in scope for --purge: this account holds 2 live fleets (main, staging)",
    "EBS snapshots tagged hermetic:role=data are kept and keep costing; deleting the stack removes the policy that made them, not the snapshots",
    "EBS volumes tagged hermetic:managed=true are kept: they hold what the agents learned, and \`destroy\` keeps them by default (§6.6)",
    "not removed by any flag, and yours to do by hand: the Tailscale OAuth client (there is no API for it) and any devices still on the tailnet",
    "Tailnet policy left unchanged; managed rules may serve other fleets. Review them manually in the Tailscale admin console if cleanup is desired.",
    "the S3 bucket, both DynamoDB tables and the VPC go with the hermetic-fxtr0001 stack",
  ],
}
`;

