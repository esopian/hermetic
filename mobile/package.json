{
  "name": "@hermetic/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.28",
    "expo-background-task": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "test-renderer": "^1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "ios:go": "expo start --ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run test && bun run lint",
    "export:ios": "expo export --platform ios --output-dir /tmp/hermetic-mobile-export",
    "build:preview": "bunx eas-cli@24.14.0 build --platform ios --profile preview",
    "build:production": "bunx eas-cli@24.14.0 build --platform ios --profile production",
    "submit:testflight": "bunx eas-cli@24.14.0 submit --platform ios --profile production",
    "release:testflight": "bunx eas-cli@24.14.0 workflow:run .eas/workflows/testflight.yml",
    "eas-build-pre-install": "bun install --cwd .. --frozen-lockfile --ignore-scripts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.jest.ts",
      "<rootDir>/test/**/*.jest.tsx"
    ],
    "setupFiles": [
      "<rootDir>/test/setup.tsx"
    ],
    "moduleNameMapper": {
      "^@hermetic/core/schema$": "<rootDir>/../packages/core/src/schema/index.ts",
      "^@hermetic/core/shared$": "<rootDir>/../packages/core/src/shared/index.ts",
      "^@hermetic/core/chat-client$": "<rootDir>/../packages/core/src/chat-client.ts",
      "^@hermetic/core/chat-client-fixture$": "<rootDir>/../packages/core/src/chat-client-fixture.ts"
    },
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
